// AWS credentials used at machine speed from one outside address
// Agentic attack detections by ThreatDefence (AI agent behavior). Source: https://github.com/ThreatDefence/agentic-attack-detections
// ATT&CK: T1078.004 (Valid Accounts: Cloud Accounts), T1580 (Cloud Infrastructure Discovery), T1555.006 (Credentials from Password Stores: Cloud Secrets Management Stores), T1651 (Cloud Administration Command)
// Example hunt for Microsoft Sentinel with AWS CloudTrail. Test and baseline before alerting.
// Elastic traced an intrusion to a CyberStrikeAI server that used eight AWS identities across four accounts from one
// address in Hong Kong (September 30 to October 16, 2026). What gave it away was speed and spread, not any one call:
//  - GetCallerIdentity for three identities in three accounts in the same second, from one external address.
//  - 56 DescribeInstanceAttribute calls for userData in 141 milliseconds from one assumed-role session.
//  - EC2 instance role credentials (session named after the instance ID) used from outside AWS for GetSecretValue
//    and GetSessionToken.
//  - GetParameter with decryption followed 29 seconds later by SSM SendCommand from the same role.
// Any agentic framework with stolen keys behaves like this; ARTEX's AWS hunts in frameworks/artex cover more APIs.

let Window = 30d;
// Your NAT gateway and instance public addresses: instance roles calling AWS from these are normal
let YourEgress = dynamic([]);
let External = AWSCloudTrail
    | where TimeGenerated > ago(Window)
    // Calls from a public IPv4 address (AWS services show a host name here, not an address)
    | where SourceIpAddress matches regex @"^\d+\.\d+\.\d+\.\d+$" and not(ipv4_is_private(SourceIpAddress))
    | where UserIdentityType != "AWSService";
union isfuzzy=true
    // Several identities or accounts checked from one address within ten minutes
    (External
        | where EventName == "GetCallerIdentity" and UserIdentityType != "AssumedRole"
        | summarize Identities=dcount(UserIdentityArn), Accounts=dcount(RecipientAccountId), Arns=make_set(UserIdentityArn, 10),
            Timestamp=min(TimeGenerated) by SourceIpAddress, bin(TimeGenerated, 10m)
        | where Identities >= 3
        | project Timestamp, SourceIpAddress, Signal="GetCallerIdentity for several identities from one address",
            Detail=strcat(Identities, " identities in ", Accounts, " accounts: ", tostring(Arns))),
    // Bulk user data reads from one principal
    (External
        | where EventName == "DescribeInstanceAttribute" and RequestParameters has "userData"
        | extend Instance = tostring(parse_json(RequestParameters).instanceId)
        | summarize Instances=dcount(Instance), Calls=count(), First=min(TimeGenerated), Last=max(TimeGenerated)
            by SourceIpAddress, UserIdentityArn, bin(TimeGenerated, 10m)
        | where Instances > 20
        | project Timestamp=First, SourceIpAddress, Signal="Bulk EC2 user data reads",
            Detail=strcat(UserIdentityArn, ": ", Instances, " instances, ", Calls, " calls in ", datetime_diff("millisecond", Last, First), " ms")),
    // Instance role credentials used from outside AWS
    (External
        | where UserIdentityType == "AssumedRole" and UserIdentityArn matches regex @"/i-[0-9a-f]{8,17}$" and SourceIpAddress !in (YourEgress)
        // The role's own instance calls from one stable address; an outside user shows up as a second address
        | join kind=inner (External | where UserIdentityArn matches regex @"/i-[0-9a-f]{8,17}$"
            | summarize RoleAddresses=dcount(SourceIpAddress) by UserIdentityArn | where RoleAddresses > 1) on UserIdentityArn
        | where EventName in ("GetSecretValue", "GetSessionToken", "GetParameter", "GetParameters", "SendCommand", "DescribeInstanceAttribute", "GetCallerIdentity")
        | summarize Events=make_set(EventName, 10), Calls=count(), Timestamp=min(TimeGenerated) by SourceIpAddress, UserIdentityArn
        | project Timestamp, SourceIpAddress, Signal="EC2 instance role credentials used from an outside address",
            Detail=strcat(UserIdentityArn, " ", tostring(Events), " x", Calls)),
    // Decrypt a parameter, then run a command, within a minute
    (External
        | where EventName == "GetParameter" and RequestParameters has "withDecryption" and RequestParameters has "true"
        | project DecryptTime=TimeGenerated, SourceIpAddress, UserIdentityArn
        | join kind=inner (External | where EventName == "SendCommand" | project SendTime=TimeGenerated, UserIdentityArn, Command=RequestParameters) on UserIdentityArn
        | where SendTime between (DecryptTime .. (DecryptTime + 1m))
        | project Timestamp=DecryptTime, SourceIpAddress, Signal="Decrypted parameter then SSM SendCommand",
            Detail=strcat(UserIdentityArn, " ", substring(Command, 0, 200)))
| order by Timestamp desc
