// One application requesting tokens for many resources in minutes
// Agentic attack detections by ThreatDefence (AI agent behavior, first written for ARTEX). Source: https://threatdefence.com/article/artex-agentic-attack-framework-detection-hunting
// ATT&CK: T1526 (Cloud Service Discovery), T1078.004 (Valid Accounts: Cloud Accounts)
// Example hunt for Microsoft Sentinel. Test and baseline before alerting.
// An agent that has an application's credentials tries every API it can reach: Microsoft Graph, Azure Resource
// Manager, Key Vault, Storage and more, inside a few minutes. Most applications use one or two resources.

AADServicePrincipalSignInLogs
| where TimeGenerated > ago(14d)
| where ResultType == "0"
| summarize Resources=dcount(ResourceDisplayName), ResourceList=make_set(ResourceDisplayName, 20),
    Sources=make_set(IPAddress, 10) by ServicePrincipalName, ServicePrincipalId, bin(TimeGenerated, 15m)
| where Resources >= 3
| join kind=leftanti (
    AADServicePrincipalSignInLogs
    | where TimeGenerated between (ago(44d) .. ago(14d)) and ResultType == "0"
    | summarize HistoricResources=dcount(ResourceDisplayName) by ServicePrincipalId, bin(TimeGenerated, 15m)
    | where HistoricResources >= 3
    | distinct ServicePrincipalId
) on ServicePrincipalId
| order by Resources desc
