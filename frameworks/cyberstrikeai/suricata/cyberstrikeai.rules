# Agentic attack detections by ThreatDefence: CyberStrikeAI
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3804001-3804499. HTTP rules need cleartext HTTP or decrypted traffic.
# Implants talking to an http_beacon listener, the curl one-liner and webshells over plain HTTP need no decryption;
# https_beacon listeners and the console use self-signed TLS. The certificate rule sees that certificate only in a TLS 1.2
# handshake: TLS 1.3, which the console prefers, encrypts it. Scan the port yourself to read the certificate.

# --- The webshell manager talking to a webshell on your server ---
alert http any any -> $HTTP_SERVERS any (msg:"TD CyberStrikeAI webshell manager user agent"; flow:established,to_server; http.user_agent; content:"CyberStrikeAI-WebShell/"; fast_pattern; classtype:web-application-attack; sid:3804001; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family CyberStrikeAI, mitre_tactic_id TA0003, mitre_tactic_name Persistence, mitre_technique_id T1505.003, mitre_technique_name Web_Shell;)
alert http any any -> $HTTP_SERVERS any (msg:"TD CyberStrikeAI webshell OS probe in URI"; flow:established,to_server; http.uri; content:"OSPROBE_"; fast_pattern; nocase; classtype:web-application-attack; sid:3804002; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family CyberStrikeAI, mitre_tactic_id TA0003, mitre_tactic_name Persistence, mitre_technique_id T1505.003, mitre_technique_name Web_Shell, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1082, mitre_technique_name System_Information_Discovery;)
alert http any any -> $HTTP_SERVERS any (msg:"TD CyberStrikeAI webshell OS probe in request body"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"OSPROBE_"; fast_pattern; classtype:web-application-attack; sid:3804003; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family CyberStrikeAI, mitre_tactic_id TA0003, mitre_tactic_name Persistence, mitre_technique_id T1505.003, mitre_technique_name Web_Shell, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1082, mitre_technique_name System_Information_Discovery;)
alert http $HTTP_SERVERS any -> any any (msg:"TD CyberStrikeAI webshell OS probe answered by a Windows server"; flow:established,to_client; http.response_body; content:":OSPROBE_Windows_NT:END"; fast_pattern; classtype:successful-admin; sid:3804004; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family CyberStrikeAI, mitre_tactic_id TA0003, mitre_tactic_name Persistence, mitre_technique_id T1505.003, mitre_technique_name Web_Shell, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1082, mitre_technique_name System_Information_Discovery;)

# --- The console's own traffic ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD CyberStrikeAI console user agent"; flow:established,to_server; http.user_agent; content:"CyberStrikeAI/"; startswith; fast_pattern; classtype:policy-violation; sid:3804005; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family CyberStrikeAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert tls any any -> any any (msg:"TD CyberStrikeAI console self-signed certificate"; flow:established,to_client; tls.cert_subject; content:"CN=CyberStrikeAI"; fast_pattern; tls.cert_issuer; content:"CN=CyberStrikeAI"; classtype:policy-violation; sid:3804006; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family CyberStrikeAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1587.003, mitre_technique_name Digital_Certificates;)

# --- Implant check-ins ---
# Go sets TCP_NODELAY, so the TCP implant sends CSB1 as a 4-byte segment of its own before its first length frame.
alert http $HOME_NET any -> any any (msg:"TD CyberStrikeAI or NeuroSploit implant token header"; flow:established,to_server; http.header_names; content:"|0d 0a|X-Implant-Token|0d 0a|"; fast_pattern; classtype:trojan-activity; sid:3804010; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family CyberStrikeAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> any any (msg:"TD CyberStrikeAI implant session header with check-in"; flow:established,to_server; http.method; content:"POST"; http.header_names; content:"|0d 0a|X-Session-Token|0d 0a|"; fast_pattern; http.uri; content:"/check_in"; endswith; classtype:trojan-activity; sid:3804011; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family CyberStrikeAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> any any (msg:"TD CyberStrikeAI implant task poll"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/tasks?session_id="; fast_pattern; http.header_names; content:"|0d 0a|X-Session-Token|0d 0a|"; classtype:trojan-activity; sid:3804012; rev:1; metadata:created_at 2026_11_21, confidence High, malware_family CyberStrikeAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD CyberStrikeAI implant default user agent (truncated Chrome string)"; flow:established,to_server; http.user_agent; content:"Mozilla/5.0 (Windows NT 10.0|3b| Win64|3b| x64) AppleWebKit/537.36"; startswith; endswith; fast_pattern; classtype:trojan-activity; sid:3804013; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family CyberStrikeAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0005, mitre_tactic_name Stealth, mitre_technique_id T1036.012, mitre_technique_name Browser_Fingerprint;)
alert tcp $HOME_NET any -> $EXTERNAL_NET any (msg:"TD CyberStrikeAI TCP implant magic CSB1"; flow:established,to_server; dsize:4; content:"CSB1"; depth:4; classtype:trojan-activity; sid:3804014; rev:1; metadata:created_at 2026_11_21, confidence Medium, malware_family CyberStrikeAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1095, mitre_technique_name Non-Application_Layer_Protocol;)
