# Agentic attack detections by ThreatDefence: Blitz Strike
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3819001-3819049. HTTP rules need cleartext HTTP or decrypted traffic.
# Blitz Strike has no web console. Its only listener is a short-lived callback server on a random port, which is plain HTTP.

# --- Requests that reach your targets ---
alert http any any -> any any (msg:"TD Blitz Strike user agent"; flow:established,to_server; http.user_agent; content:"blitzstrike"; nocase; fast_pattern; classtype:web-application-attack; sid:3819001; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family BlitzStrike, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
