# Agentic attack detections by ThreatDefence: Sage (Mythic)
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3819101-3819149. HTTP rules need cleartext HTTP or decrypted traffic.
# Strings from MythicAgents/sage at cbff42f0abc54d3c64b40d3a71cffce01a057023. Sage reaches targets only through Mythic payload
# callbacks, whose C2 traffic belongs to the payload type and is not covered here. The Phoenix trace UI (port 6006) is plain HTTP.

# --- The embedded Arize Phoenix trace UI ---
alert http any 6006 -> any any (msg:"TD Sage (Mythic) embedded Phoenix trace UI page on port 6006"; flow:established,to_client; http.response_body; content:"<title>Phoenix</title>"; fast_pattern; classtype:policy-violation; sid:3819101; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Sage, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Sage (Mythic) kernel trace spans served by Phoenix"; flow:established,to_client; http.response_body; content:"sage.kernel."; fast_pattern; pcre:"/sage\.kernel\.(?:episode|cycle|seam\.)/"; classtype:policy-violation; sid:3819102; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Sage, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Sage's own requests from the Mythic server ---
alert http any any -> any any (msg:"TD Sage (Mythic) token scope preflight to the Mythic GraphQL API"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/graphql"; http.request_body; content:"query sageWhoamiScopes"; fast_pattern; classtype:policy-violation; sid:3819103; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Sage, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Sage (Mythic) named query to the Mythic GraphQL API"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/graphql"; http.request_body; content:"query Sage"; fast_pattern; pcre:"/query Sage(?:Reconcile|Credit|Cited|Memory|Task|Command|Payload|Op|Read|State|Engagement|Findings|Watcher|Report|Channel|Operation)[A-Za-z]*\s*[({]/"; classtype:policy-violation; sid:3819104; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Sage, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Sage (Mythic) findings notice to a Slack webhook"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"Sage findings changed. Open Mythic to review."; fast_pattern; classtype:policy-violation; sid:3819105; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Sage, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Sage (Mythic) SharpHound release fetched by python-requests"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/SpecterOps/SharpHound/releases/download/v2.13.0/SharpHound_v2.13.0_windows_x86.zip"; fast_pattern; http.user_agent; content:"python-requests/"; startswith; classtype:policy-violation; sid:3819106; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Sage, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)

# --- Sage's prompts and tools in model requests (decrypted) ---
alert http any any -> any any (msg:"TD Sage (Mythic) Mythic Operator prompt in a model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"you drive all Mythic C2 operations and in-memory offensive tradecraft"; fast_pattern; classtype:policy-violation; sid:3819107; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Sage, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Sage (Mythic) BloodHound agent prompt in a model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"the single owner of the BloodHound attack-graph in Sage"; fast_pattern; classtype:policy-violation; sid:3819108; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Sage, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Sage (Mythic) TTP library tool names in a model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"get_ttp_guidance"; fast_pattern; content:"list_ttp_categories"; classtype:policy-violation; sid:3819109; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Sage, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
