# Agentic attack detections by ThreatDefence: OpenHack
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3813361-3813375. HTTP rules need cleartext HTTP or decrypted traffic.
# Strings come from openhackai/OpenHack: the v0.x pentest agent at tag v0.2.4 (8fdfdddf, PyPI openhack 0.2.4) and the
# v2 source-code scanner at f94e153c. v2 sends nothing to targets; the target-side rules are for v0.2.4.

# --- Targets calling the v0.2.4 out-of-band collector (blind SSRF, command injection, XXE) ---
alert dns $HOME_NET any -> any any (msg:"TD OpenHack out-of-band collector lookup (oob.openhack.com)"; dns.query; dotprefix; content:".oob.openhack.com"; nocase; endswith; fast_pattern; classtype:web-application-attack; sid:3813361; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family OpenHack, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)
alert tls $HOME_NET any -> any any (msg:"TD OpenHack out-of-band collector in TLS SNI (oob.openhack.com)"; flow:established,to_server; tls.sni; dotprefix; content:".oob.openhack.com"; nocase; endswith; fast_pattern; classtype:web-application-attack; sid:3813362; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family OpenHack, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> any any (msg:"TD OpenHack out-of-band collector in cleartext HTTP Host (oob.openhack.com)"; flow:established,to_server; http.host; dotprefix; content:".oob.openhack.com"; endswith; fast_pattern; classtype:web-application-attack; sid:3813363; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family OpenHack, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Requests that reach your targets (v0.2.4) ---
alert http any any -> $HTTP_SERVERS any (msg:"TD OpenHack collector host in a request URI (SSRF or callback probe)"; flow:established,to_server; http.uri; content:"oob.openhack.com"; nocase; fast_pattern; classtype:web-application-attack; sid:3813364; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family OpenHack, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD OpenHack canary marker in a request URI (__openhack_test_)"; flow:established,to_server; http.uri; content:"__openhack_test_"; fast_pattern; classtype:web-application-attack; sid:3813365; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family OpenHack, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> $HTTP_SERVERS any (msg:"TD OpenHack canary marker in a request body (__openhack_test_)"; flow:established,to_server; http.request_body; content:"__openhack_test_"; fast_pattern; classtype:web-application-attack; sid:3813366; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family OpenHack, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD OpenHack web_fetch user agent (Chrome/125.0 with a two-part version)"; flow:established,to_server; http.user_agent; content:"Chrome/125.0 Safari/537.36"; fast_pattern; content:"Intel Mac OS X 10_15_7"; classtype:attempted-recon; sid:3813367; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family OpenHack, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)

# --- Traffic from a host that runs or installs OpenHack ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD OpenHack v0.x client user agent (openhack)"; flow:established,to_server; http.user_agent; content:"openhack"; bsize:8; fast_pattern; classtype:policy-violation; sid:3813368; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family OpenHack, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert dns $HOME_NET any -> any any (msg:"TD OpenHack v0.x model gateway or update check lookup (api.openhack.com)"; dns.query; dotprefix; content:".api.openhack.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3813369; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family OpenHack, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert tls $HOME_NET any -> any any (msg:"TD OpenHack v0.x model gateway or update check in TLS SNI (api.openhack.com)"; flow:established,to_server; tls.sni; dotprefix; content:".api.openhack.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3813370; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family OpenHack, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert dns $HOME_NET any -> any any (msg:"TD OpenHack v2 installer lookup (install.openhack.com)"; dns.query; dotprefix; content:".install.openhack.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3813371; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family OpenHack, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert tls $HOME_NET any -> any any (msg:"TD OpenHack v2 installer in TLS SNI (install.openhack.com)"; flow:established,to_server; tls.sni; dotprefix; content:".install.openhack.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3813372; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family OpenHack, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)

# --- A v2 dashboard reachable from the network (it binds 127.0.0.1; only a port forward exposes it) ---
alert http any any -> any any (msg:"TD OpenHack v2 dashboard host check answer (port forwarded)"; flow:established,to_client; http.response_body; content:"This dashboard only accepts requests addressed to localhost."; fast_pattern; classtype:policy-violation; sid:3813373; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family OpenHack, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert http any any -> any any (msg:"TD OpenHack v2 dashboard health answer"; flow:established,to_client; http.response_body; content:"{|22|app|22 3a 22|openhack|22 2c 22|version|22 3a 22|"; fast_pattern; classtype:policy-violation; sid:3813374; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family OpenHack, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
