# Agentic attack detections by ThreatDefence: KaliGPT (HackerX)
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3813221-3813235 (3813236 is the address-rule base). Strings from SudoHopeX/KaliGPT at b15b8d48
# (branch hackerx, KaliGPT v1.3) and its companion SudoHopeX/OpenSearchAPI at 02108aba.
# KaliGPT is a CLI. It has no web console; its helper search API (OpenSearchAPI, Flask) listens on 127.0.0.1:5000 unless an
# operator changes it, so 3813223 only fires if someone exposes that helper or you watch loopback/host traffic.
# 3813221 and 3813222 see a target's plain-HTTP pages; HTTPS targets need TLS inspection or web server logs.

# --- KaliGPT's own HTTP tools (agents/utils/tools/web_request_framework.py:63,276; agents/utils/tools/locals.py:35) ---
alert http any any -> any any (msg:"TD KaliGPT web_request_framework user agent (target page analysis)"; flow:established,to_server; http.user_agent; content:"HackerX WebRequestFramework/1.0"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3813221; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family KaliGPT, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1594, mitre_technique_name Search_Victim-Owned_Websites;)
alert http any any -> any any (msg:"TD KaliGPT get_local_server_content user agent"; flow:established,to_server; http.user_agent; content:"LocalScraper/1.0"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3813222; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family KaliGPT, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1594, mitre_technique_name Search_Victim-Owned_Websites;)

# --- OpenSearchAPI helper docs page (OpenSearchAPI templates/index.html:6, served on GET / by app.py:55-58) ---
alert http any any -> any any (msg:"TD KaliGPT OpenSearchAPI search helper docs page"; flow:established,to_client; http.response_body; content:"<title>OpenSearchAPI API |7c| Docs</title>"; fast_pattern; classtype:policy-violation; sid:3813223; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family KaliGPT, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1593.002, mitre_technique_name Search_Engines;)
