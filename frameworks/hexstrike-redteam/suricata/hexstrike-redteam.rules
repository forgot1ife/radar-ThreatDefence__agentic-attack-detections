# Agentic attack detections by ThreatDefence: Hexstrike-redteam (HexStrike AI fork with the BOAZ payload framework)
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3817901-3817949. HTTP rules need cleartext HTTP or decrypted traffic.
# The server API is plain HTTP on 8888 by default (HEXSTRIKE_PORT or --port changes it), so these rules match any port.
# The HexStrike rules 3803001-3803012 also fire on this fork; these rules match only the /api/boaz/ routes it adds.

# --- Requests to the BOAZ routes (an exposed server, or an MCP client driving one) ---
alert http any any -> any any (msg:"TD Hexstrike-redteam BOAZ payload generation request"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/boaz/generate-payload"; startswith; fast_pattern; classtype:trojan-activity; sid:3817901; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Hexstrike_redteam, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1587.001, mitre_technique_name Malware, mitre_tactic_id TA0005, mitre_tactic_name Stealth, mitre_technique_id T1027.002, mitre_technique_name Software_Packing;)
alert http any any -> any any (msg:"TD Hexstrike-redteam BOAZ loader or encoder list request"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/api/boaz/list-"; startswith; fast_pattern; classtype:policy-violation; sid:3817902; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Hexstrike_redteam, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1587.001, mitre_technique_name Malware;)
alert http any any -> any any (msg:"TD Hexstrike-redteam BOAZ binary analysis request"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/boaz/analyze-binary"; startswith; fast_pattern; classtype:policy-violation; sid:3817903; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Hexstrike_redteam, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1587.001, mitre_technique_name Malware;)
alert http any any -> any any (msg:"TD Hexstrike-redteam BOAZ option validation request"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/boaz/validate-options"; startswith; fast_pattern; classtype:policy-violation; sid:3817904; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Hexstrike_redteam, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1587.001, mitre_technique_name Malware;)

