rule Cain_Agent_Source_Or_Prompt
{
    meta:
        description = "Cain source tree, a Docker image layer or an install that holds it, or a model session transcript with its prompts: the recon and test stage prompts, the validation prompt, the pi backend system prompt, the scope.yaml header and the XSS echo marker"
        mitre_att = "T1588.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/cdxiaodong/cain-agent"
        confidence = "high"
    strings:
        // "Cain 的侦察 Agent" and "Cain 的测试 Agent" (src/cain_agent/handlers.py:296,451)
        $recon = { 43 61 69 6E 20 E7 9A 84 E4 BE A6 E5 AF 9F 20 41 67 65 6E 74 }
        $test = { 43 61 69 6E 20 E7 9A 84 E6 B5 8B E8 AF 95 20 41 67 65 6E 74 }
        // "# Cain 渗透测试报告" (src/cain_agent/report_markdown.py:510)
        $title = { 23 20 43 61 69 6E 20 E6 B8 97 E9 80 8F E6 B5 8B E8 AF 95 E6 8A A5 E5 91 8A }
        $scope = "# scope.yaml \xE2\x80\x94 generated by `cain-agent run`" ascii
        $pi_sys = "You are the execution engine of an authorized security-testing pipeline." ascii
        $pi_pkg = "\"name\": \"cain-agent-pi-bridge\"" ascii
        $prog = "prog=\"cain-agent\"" ascii
        $xss = "cainxss7f3a" ascii
    condition:
        filesize < 20MB and any of them
}

rule Cain_Agent_Workspace_Files
{
    meta:
        description = "Files a Cain run writes into its workspace: scope.yaml, recon/gate.json, report/report.md and report/aggregated-report.json"
        mitre_att = "T1595.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/cdxiaodong/cain-agent"
        confidence = "high"
    strings:
        $scope = "# scope.yaml \xE2\x80\x94 generated by `cain-agent run`" ascii
        $gate = "\"recon_gate\": \"" ascii
        $title = { 23 20 43 61 69 6E 20 E6 B8 97 E9 80 8F E6 B5 8B E8 AF 95 E6 8A A5 E5 91 8A }
        // "本报告由 Cain 在" (legal notice, src/cain_agent/report_markdown.py:493)
        $legal = { E6 9C AC E6 8A A5 E5 91 8A E7 94 B1 20 43 61 69 6E 20 E5 9C A8 }
        $route = "\"route\": \"multi_agent\"" ascii
        $dissent = "\"model_dissent\":" ascii
        $memory = "\"memory_hits\":" ascii
    condition:
        filesize < 50MB and ($scope or $gate or ($title and $legal) or ($route and $dissent and $memory))
}
