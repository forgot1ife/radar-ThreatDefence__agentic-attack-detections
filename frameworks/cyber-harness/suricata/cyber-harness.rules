# Agentic attack detections by ThreatDefence: cyber-harness
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3817601-3817649. From the cyber-harness source code (chainreactors/cyber-harness at 02ac8ecf,
# and v0.4.0 for the older AIScan strings). HTTP rules need cleartext HTTP or decrypted traffic. The Web Hub (8080) is
# plain HTTP, so its rules work without decryption.

# --- Requests that reach your targets (tools/scan/http_auth.go, tools/search/fetch.go, tools/curl/client.go) ---
alert http any any -> $HTTP_SERVERS any (msg:"TD cyber-harness scan pipeline basic-auth probe user agent (cyber)"; flow:established,to_server; http.user_agent; content:"cyber"; bsize:5; fast_pattern; classtype:attempted-recon; sid:3817601; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family cyber-harness, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0006, mitre_tactic_name Credential_Access, mitre_technique_id T1110.001, mitre_technique_name Password_Guessing;)
alert http any any -> $HTTP_SERVERS any (msg:"TD cyber-harness fetch tool user agent"; flow:established,to_server; http.user_agent; content:"(compatible|3b| cyber/1.0|3b| +https|3a|//github.com/chainreactors/cyber-harness)"; fast_pattern; classtype:attempted-recon; sid:3817602; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family cyber-harness, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> $HTTP_SERVERS any (msg:"TD cyber-harness (AIScan build) basic-auth probe user agent (aiscan)"; flow:established,to_server; http.user_agent; content:"aiscan"; bsize:6; fast_pattern; classtype:attempted-recon; sid:3817603; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family cyber-harness, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0006, mitre_tactic_name Credential_Access, mitre_technique_id T1110.001, mitre_technique_name Password_Guessing;)
alert http any any -> $HTTP_SERVERS any (msg:"TD cyber-harness (AIScan build) fetch tool user agent"; flow:established,to_server; http.user_agent; content:"(compatible|3b| aiscan/1.0|3b| +https|3a|//github.com/chainreactors/aiscan)"; fast_pattern; classtype:attempted-recon; sid:3817604; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family cyber-harness, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> $HTTP_SERVERS any (msg:"TD cyber-harness curl tool browser header set (Chrome 133 brands with Linux user agent)"; flow:established,to_server; http.header; content:"|22|Chromium|22 3b|v=|22|133|22 2c 20 22|Google Chrome|22 3b|v=|22|133|22 2c 20 22|Not(A|3a|Brand|22 3b|v=|22|24|22|"; fast_pattern; http.user_agent; content:"Mozilla/5.0 (X11|3b| Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/133.0.0.0 Safari/537.36"; bsize:101; classtype:attempted-recon; sid:3817605; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family cyber-harness, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)

# --- MCP client requests to the MCP servers the operator configured (tools/mcp/connection.go) ---
alert http any any -> any any (msg:"TD cyber-harness MCP client initialize (clientInfo cyber-harness mcp-ext)"; flow:established,to_server; http.request_body; content:"|22|clientInfo|22|"; content:"|22|name|22 3a 22|cyber-harness|22|"; fast_pattern; content:"|22|mcp-ext|22|"; classtype:policy-violation; sid:3817606; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family cyber-harness, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD cyber-harness MCP client JSON-RPC request id (cyber-mcp-)"; flow:established,to_server; http.request_body; content:"|22|id|22 3a 22|cyber-mcp-"; fast_pattern; content:"|22|jsonrpc|22|"; classtype:policy-violation; sid:3817607; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family cyber-harness, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- The Web Hub (cyber-harness, plain HTTP, 127.0.0.1:8080 by default; pkg/web, web/frontend/index.html) ---
alert http any any -> any any (msg:"TD cyber-harness Web Hub page"; flow:established,to_client; http.response_body; content:"<title>Cyber</title>"; content:"localStorage.getItem(|27|cyber-theme|27|)"; fast_pattern; classtype:policy-violation; sid:3817610; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family cyber-harness, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD cyber-harness (AIScan build) Web page"; flow:established,to_client; http.response_body; content:"<title>AIScan</title>"; content:"localStorage.getItem(|27|aiscan-theme|27|)"; fast_pattern; classtype:policy-violation; sid:3817611; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family cyber-harness, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD cyber-harness Web Hub CORS header set (any path)"; flow:established,to_client; http.header; content:"Content-Type, Authorization, Connect-Protocol-Version, Connect-Timeout-Ms, Connect-Content-Encoding, Connect-Accept-Encoding"; fast_pattern; content:"X-Grpc-Web, X-User-Agent"; distance:0; classtype:policy-violation; sid:3817612; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family cyber-harness, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD cyber-harness Web Hub API refused without access key"; flow:established,to_client; http.stat_code; content:"401"; http.response_body; content:"{|22|error|22 3a 22|invalid or missing access key|22|}"; fast_pattern; http.header; content:"X-Grpc-Web, X-User-Agent"; classtype:policy-violation; sid:3817613; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family cyber-harness, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD cyber-harness Web Hub login sets session cookie"; flow:established,to_client; http.cookie; content:"cyber_session="; startswith; fast_pattern; content:"SameSite=Strict"; classtype:policy-violation; sid:3817614; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family cyber-harness, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
