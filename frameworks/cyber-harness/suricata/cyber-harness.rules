# --- Nodes and browsers talking to a Hub (pkg/web/service.go, pkg/node/proto_connection.go, pkg/rpc) ---
alert http any any -> any any (msg:"TD cyber-harness node connecting to a Web Hub (AOP node WebSocket)"; flow:established,to_server; http.uri; content:"/api/aop/node/ws"; startswith; fast_pattern; http.header; content:"websocket"; nocase; classtype:policy-violation; sid:3817616; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family cyber-harness, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD cyber-harness Web Hub application WebSocket"; flow:established,to_server; http.uri; content:"/api/aop/application/ws"; startswith; fast_pattern; http.header; content:"websocket"; nocase; classtype:policy-violation; sid:3817617; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family cyber-harness, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD cyber-harness Web Hub ConnectRPC call"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/cyber.rpc."; startswith; fast_pattern; pcre:"/^\/cyber\.rpc\.(?:aop|chat|scan|config|agent|system|artifact)\.[A-Za-z]+Service\//"; classtype:policy-violation; sid:3817618; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family cyber-harness, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
