# Agentic attack detections by ThreatDefence: Incalmo
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3818301-3818349. HTTP rules need cleartext HTTP or decrypted traffic.
# The Incalmo C2 server (default port 8888) is plain HTTP, so its rules work without decryption.
# The beacon and /file/download rules also match MITRE Caldera, whose Sandcat implant and contact protocol Incalmo uses.

# --- An exposed or reachable Incalmo C2 server ---
alert http any any -> any any (msg:"TD Incalmo C2 server root response"; flow:established,to_client; http.response_body; content:"Incalmo C2 Server API"; fast_pattern; classtype:policy-violation; sid:3818301; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Incalmo, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Incalmo C2 server health response"; flow:established,to_client; http.response_body; content:"Flask + Celery"; fast_pattern; content:"running_strategies"; classtype:policy-violation; sid:3818302; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Incalmo, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Incalmo web console page"; flow:established,to_client; http.response_body; content:"<title>Incalmo</title>"; fast_pattern; classtype:policy-violation; sid:3818310; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Incalmo, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Implant traffic (Caldera Sandcat contact protocol, served by Incalmo) ---
alert http any any -> any any (msg:"TD Incalmo or Caldera Sandcat beacon answer"; flow:established,to_client; http.response_body; content:"eyJwYXciOiAi"; startswith; fast_pattern; classtype:trojan-activity; sid:3818303; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Incalmo, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Incalmo or Caldera Sandcat beacon request"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/beacon"; startswith; endswith; fast_pattern; http.request_body; content:"eyJ"; startswith; classtype:trojan-activity; sid:3818304; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Incalmo, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Incalmo or Caldera Sandcat implant download"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/file/download"; startswith; http.header; content:"sandcat.go"; nocase; fast_pattern; classtype:trojan-activity; sid:3818305; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Incalmo, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)
alert http any any -> any any (msg:"TD Incalmo agent download route"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/agent/download"; startswith; fast_pattern; http.header_names; content:"|0d 0a|File|0d 0a|"; nocase; classtype:trojan-activity; sid:3818306; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Incalmo, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)
alert http any any -> any any (msg:"TD Incalmo per-command script fetched by an implant"; flow:established,to_server; http.uri; content:"/file/download"; startswith; http.header; content:"dynamic_payload_"; fast_pattern; classtype:trojan-activity; sid:3818307; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Incalmo, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059.004, mitre_technique_name Unix_Shell;)
alert http any any -> any any (msg:"TD Incalmo exploit or helper payload fetched by an implant"; flow:established,to_server; http.uri; content:"/file/download"; startswith; fast_pattern; http.header; pcre:"/(?:becomeUserAgent\.sh|runDeployAgent\.sh|downloadAgent\.sh|strutsExploit\.py|sudo_baron_exploit\.py|sudoedit_exploit\.sh|writeable_passwd\.sh|sudoexploit\.py|msf_rpc_client\.py|bind_metasploit_session|sandcat\.go-linux|manual_command_\d+\.sh|kill_agent\.sh)/"; classtype:trojan-activity; sid:3818308; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Incalmo, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)

# --- The operator and strategy API of the C2 server ---
alert http any any -> any any (msg:"TD Incalmo LLM agent action queue request"; flow:established,to_server; http.uri; content:"_llm_agent_"; fast_pattern; pcre:"/^\/(?:(?:get|start)_llm_agent_action|stream_llm_agent_logs)(?:$|\?)/"; classtype:attempted-admin; sid:3818311; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Incalmo, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Incalmo strategy start request"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/startup"; startswith; endswith; http.request_body; content:"|22|c2c_server|22|"; fast_pattern; content:"|22|strategy|22|"; classtype:attempted-admin; sid:3818312; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Incalmo, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Incalmo environment state report"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/update_environment_state"; startswith; fast_pattern; classtype:attempted-admin; sid:3818313; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Incalmo, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Incalmo command tasking request"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/send_"; startswith; pcre:"/^\/send_(?:manual_)?command$/"; http.request_body; content:"|22|agent|22|"; content:"|22|command|22|"; fast_pattern; classtype:attempted-admin; sid:3818314; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Incalmo, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059.004, mitre_technique_name Unix_Shell, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
