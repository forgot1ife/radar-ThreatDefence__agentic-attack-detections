# Agentic attack detections by ThreatDefence: NyxStrike
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3817001-3817049. HTTP rules need cleartext HTTP or decrypted traffic.
# The NyxStrike server (8888) is plain HTTP from Flask's built-in server, so its rules work without decryption.
# NyxStrike shares code with HexStrike. HexStrike rules 3803003 (Mozilla/5.0 (Compatible Exploit)) and 3803011
# (POST /api/tools/ on 8888) also fire on NyxStrike; the rules below match only strings NyxStrike changed or added.

# --- Requests that reach your targets ---
alert http any any -> any any (msg:"TD NyxStrike decision engine user agent"; flow:established,to_server; http.user_agent; content:"NyxStrike/"; startswith; fast_pattern; classtype:web-application-attack; sid:3817001; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NyxStrike, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD NyxStrike HTTP framework user agent"; flow:established,to_server; http.user_agent; content:"Security-HTTP-Framework/"; fast_pattern; classtype:web-application-attack; sid:3817002; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NyxStrike, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD NyxStrike browser agent user agent"; flow:established,to_server; http.user_agent; content:"Security-BrowserAgent/"; fast_pattern; classtype:web-application-attack; sid:3817003; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NyxStrike, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
