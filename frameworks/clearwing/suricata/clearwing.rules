# --- An exposed Clearwing web UI (8899) ---
alert http any any -> any any (msg:"TD Clearwing web UI page"; flow:established,to_client; http.response_body; content:"Target (IP / hostname / CIDR)"; fast_pattern; content:"<title>Clearwing</title>"; classtype:policy-violation; sid:3819517; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Clearwing, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert http any any -> any any (msg:"TD Clearwing web UI health answer"; flow:established,to_client; http.response_body; content:"{|22|status|22 3a 22|ok|22 2c 22|service|22 3a 22|clearwing|22|}"; fast_pattern; classtype:policy-violation; sid:3819518; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Clearwing, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert http any any -> any any (msg:"TD Clearwing web UI operator API answer (CLEARWING_WEB_API_KEY)"; flow:established,to_client; http.response_body; content:"CLEARWING_WEB_API_KEY is not set"; fast_pattern; classtype:policy-violation; sid:3819519; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Clearwing, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
