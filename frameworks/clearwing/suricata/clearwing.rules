# Agentic attack detections by ThreatDefence: Clearwing
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3819501-3819549. HTTP rules need cleartext HTTP or decrypted traffic.
# The web UI (8899), the sourcehunt webhook (8787) and the callback listener (9999-10008) are plain HTTP, so their rules
# work without decryption. Strings come from Lazarus-AI-OSS/clearwing at 08fe47d2.

# --- Requests that reach your targets ---
alert http any any -> $HTTP_SERVERS any (msg:"TD Clearwing browser or bundle analyzer user agent (Clearwing/1.0)"; flow:established,to_server; http.user_agent; content:"Clearwing/1.0"; fast_pattern; classtype:web-application-attack; sid:3819501; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Clearwing, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD Clearwing attack-surface discovery user agent (clearwing-asm)"; flow:established,to_server; http.user_agent; content:"clearwing-asm/"; startswith; fast_pattern; classtype:attempted-recon; sid:3819502; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Clearwing, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Clearwing 1Password Mycelium probe client header (OP-User-Agent ...|clearwing|)"; flow:established,to_server; http.header; content:"OP-User-Agent|3a 20|1|7c|B|7c|2248|7c|clearwing|7c|"; nocase; fast_pattern; classtype:web-application-attack; sid:3819503; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Clearwing, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Clearwing SRP user enumeration probe (nonexistent-<hex>@invalid.test)"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"@invalid.test"; fast_pattern; content:"nonexistent-"; pcre:"/\x22email\x22:\s*\x22nonexistent-[0-9a-f]{8}@invalid\.test\x22/"; classtype:attempted-recon; sid:3819504; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Clearwing, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1589.002, mitre_technique_name Email_Addresses;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Clearwing account recovery code probe (recoveryCode and recovery_code in one body)"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"|22|recovery_code|22 3a 20 22|"; fast_pattern; content:"|22|recoveryCode|22 3a 20 22|"; classtype:attempted-admin; sid:3819505; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Clearwing, mitre_tactic_id TA0006, mitre_tactic_name Credential_Access, mitre_technique_id T1110.001, mitre_technique_name Password_Guessing;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Clearwing Struts CVE-2017-5638 check (whoami OGNL in Content-Type, bare Mozilla/5.0)"; flow:established,to_server; http.content_type; content:"(#cmd='whoami')"; fast_pattern; http.user_agent; content:"Mozilla/5.0"; bsize:11; classtype:web-application-attack; sid:3819506; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Clearwing, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert tcp any any -> $HOME_NET 21 (msg:"TD Clearwing ProFTPD mod_copy check (CPTO /tmp/passwd)"; flow:established,to_server; content:"CPFR /etc/passwd|0d 0a|"; content:"CPTO /tmp/passwd|0d 0a|"; fast_pattern; classtype:attempted-admin; sid:3819507; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Clearwing, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert ssh any any -> $HOME_NET any (msg:"TD Clearwing service scanner SSH probe banner (client OpenSSH_7.0)"; flow:established,to_server; ssh.software; content:"OpenSSH_7.0"; bsize:11; fast_pattern; classtype:attempted-recon; sid:3819508; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Clearwing, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595, mitre_technique_name Active_Scanning;)

# --- Payloads that the agent writes and sends to a target ---
alert http any any -> any any (msg:"TD Clearwing deconfliction watermark in a request body (### WATERMARK OPID:)"; flow:established,to_server; http.request_body; content:"### WATERMARK OPID|3a|"; fast_pattern; content:" SIG|3a|"; distance:0; classtype:trojan-activity; sid:3819509; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Clearwing, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)
alert http any any -> any any (msg:"TD Clearwing deconfliction watermark in a downloaded file (### WATERMARK OPID:)"; flow:established,to_client; http.response_body; content:"### WATERMARK OPID|3a|"; fast_pattern; content:" SIG|3a|"; distance:0; classtype:trojan-activity; sid:3819510; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Clearwing, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)
alert http any any -> any any (msg:"TD Clearwing XOR exec stub in a downloaded file (obfuscate_payload)"; flow:established,to_client; http.response_body; content:"bytes(a ^ b for a, b in zip("; fast_pattern; content:")).decode()|0a|exec("; distance:0; content:"base64.b64decode('"; classtype:trojan-activity; sid:3819511; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Clearwing, mitre_tactic_id TA0005, mitre_tactic_name Stealth, mitre_technique_id T1027.013, mitre_technique_name Encrypted/Encoded_File, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)
alert http any any -> any any (msg:"TD Clearwing sleeper beacon script in a downloaded file (generate_c2_beacon)"; flow:established,to_client; http.response_body; content:"C2 + |22|/checkin|22|"; fast_pattern; content:"JITTER = "; content:"C2 + |22|/result|22|"; classtype:trojan-activity; sid:3819512; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Clearwing, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD Clearwing sleeper beacon check-in (GET /checkin, Python-urllib)"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/checkin"; endswith; fast_pattern; http.user_agent; content:"Python-urllib/"; startswith; classtype:trojan-activity; sid:3819513; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Clearwing, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> $EXTERNAL_NET [9999:10008] (msg:"TD Clearwing out-of-band callback to its listener (/callback/<24 char token>, ports 9999-10008)"; flow:established,to_server; http.uri; content:"/callback/"; startswith; fast_pattern; pcre:"/^\/callback\/[A-Za-z0-9_-]{24}(?:[?\/]|$)/"; classtype:web-application-attack; sid:3819514; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Clearwing, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

