# Agentic attack detections by ThreatDefence: Cybermes
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3813301-3813315. Strings from Zyrexnn/Cybermes at 149b9a66 (v3.5.1 plus docs commits).
# Cybermes runs Hermes Agent; the Hermes rules in frameworks/hermes cover the Hermes dashboard and WebUI.
# Cybermes adds no listener of its own (its MCP server is stdio only), so there are no console rules here.
# 3813301-3813303 and 3813305-3813308 see a target's plain-HTTP traffic; HTTPS targets need TLS inspection or web logs.
# 3813304, 3813309, 3813312 need decrypted outbound traffic; 3813310-3813311 need model traffic in clear text
# (a TLS-inspecting proxy, an AI gateway or a local model server).

# --- User agents of the Go MCP server (cybermes-mcp) when its native engines run instead of katana, httpx and ffuf ---
alert http any any -> any any (msg:"TD Cybermes recon crawler user agent"; flow:established,to_server; http.user_agent; content:"Cybermes/2.1 (Recon Crawler)"; endswith; fast_pattern; classtype:attempted-recon; sid:3813301; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Cybermes, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1594, mitre_technique_name Search_Victim-Owned_Websites;)
alert http any any -> any any (msg:"TD Cybermes HTTP probe user agent"; flow:established,to_server; http.user_agent; content:"Cybermes/2.1 (Security Assessment)"; endswith; fast_pattern; classtype:attempted-recon; sid:3813302; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Cybermes, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1592.002, mitre_technique_name Software;)
alert http any any -> any any (msg:"TD Cybermes endpoint fuzzer user agent"; flow:established,to_server; http.user_agent; content:"Cybermes/3.2 (API Fuzzer)"; endswith; fast_pattern; classtype:attempted-recon; sid:3813303; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Cybermes, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.003, mitre_technique_name Wordlist_Scanning;)
alert http $HOME_NET any -> any any (msg:"TD Cybermes subdomain discovery query to crt.sh (decrypted)"; flow:established,to_server; http.user_agent; content:"Cybermes/3.2 (Subdomain Recon)"; endswith; fast_pattern; http.uri; content:"output=json"; classtype:policy-violation; sid:3813304; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Cybermes, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1596.003, mitre_technique_name Digital_Certificates;)

# --- User agents and markers of the bundled audit scripts and prompt rules ---
alert http any any -> any any (msg:"TD Cybermes AI gateway auditor user agent"; flow:established,to_server; http.user_agent; content:"Cybermes-AIGateway-Auditor/"; startswith; fast_pattern; classtype:attempted-recon; sid:3813305; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Cybermes, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD Cybermes AI gateway auditor CORS canary origin"; flow:established,to_server; http.header; content:"Origin|3a 20|https://audit-canary.example.com"; fast_pattern; classtype:attempted-recon; sid:3813306; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Cybermes, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD Cybermes exam state machine auditor user agent"; flow:established,to_server; http.user_agent; content:"Cybermes-ExamAuditor/"; startswith; fast_pattern; classtype:attempted-recon; sid:3813307; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Cybermes, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD Cybermes security auditor user agent from model-written scripts"; flow:established,to_server; http.user_agent; content:"Cybermes-Security-Auditor/"; startswith; fast_pattern; classtype:attempted-recon; sid:3813308; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Cybermes, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)

# --- Install and update traffic from the host that runs it ---
alert http $HOME_NET any -> any any (msg:"TD Cybermes MCP npm update check (decrypted)"; flow:established,to_server; http.user_agent; content:"cybermes-mcp-updater/"; startswith; fast_pattern; http.uri; content:"/cybermes-mcp/latest"; classtype:policy-violation; sid:3813309; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Cybermes, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert http $HOME_NET any -> any any (msg:"TD Cybermes MCP native binary download from GitHub releases (decrypted)"; flow:established,to_server; http.uri; content:"/Zyrexnn/Cybermes/releases/download/"; fast_pattern; content:"/cybermes-mcp-v"; classtype:policy-violation; sid:3813312; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Cybermes, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)

# --- Cybermes persona and MCP tool names inside cleartext or decrypted model requests ---
alert http $HOME_NET any -> any any (msg:"TD Cybermes persona in model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"You are Cybermes, an "; fast_pattern; classtype:policy-violation; sid:3813310; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Cybermes, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.007, mitre_technique_name Artificial_Intelligence;)
alert http $HOME_NET any -> any any (msg:"TD Cybermes MCP tool definitions in model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"cybermes_fuzz_endpoints"; fast_pattern; content:"cybermes_recon_crawl"; classtype:policy-violation; sid:3813311; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Cybermes, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.007, mitre_technique_name Artificial_Intelligence;)
