/*
   Agentic attack detections by ThreatDefence: Cybermes
   https://github.com/ThreatDefence/agentic-attack-detections

   Experimental. Built from the Cybermes source code (Zyrexnn/Cybermes at 149b9a66, v3.5.1 plus documentation commits).
   Cybermes runs Hermes Agent; the Hermes rules in frameworks/hermes cover Hermes itself.
*/

rule Cybermes_Persona_Or_Config
{
    meta:
        description = "Cybermes Hermes persona (.hermes/SOUL.md) or configuration (.hermes/config.yaml from config.yaml.example): the Cybermes system prompt that tells the model every operator-named target is authorized, approvals off and the autonomous-godmode-hunter skill auto-loaded"
        mitre_att = "T1588.007"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/Zyrexnn/Cybermes/blob/149b9a66752244bbb78926dcdc94dfc5b647ed80/.hermes/config.yaml.example"
        confidence = "high"
    strings:
        $soul = "You are Cybermes, an elite autonomous offensive security" ascii wide
        $sys = "You are Cybermes, an automated security testing, API diagnostic, and vulnerability assessment agent." ascii wide
        $c1 = "DIRECT OPERATOR AUTHORIZATION" ascii
        $c2 = "autonomous-godmode-hunter" ascii
        $c3 = "aggregate_reports <SLUG>" ascii
        $c4 = "name: Cybermes" ascii
    condition:
        filesize < 200KB and ($soul or $sys or 3 of ($c*))
}

rule Cybermes_Code_Or_MCP_Binary
{
    meta:
        description = "Cybermes source, the cybermes-mcp Go binary (release, npm cache ~/.cybermes/bin or /usr/local/bin in the Docker image) or the npm launcher: its fixed user agents, MCP server name and tool names"
        mitre_att = "T1588.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/Zyrexnn/Cybermes"
        confidence = "high"
    strings:
        $ua1 = "Cybermes/2.1 (Recon Crawler)" ascii
        $ua2 = "Cybermes/2.1 (Security Assessment)" ascii
        $ua3 = "Cybermes/3.2 (API Fuzzer)" ascii
        $ua4 = "Cybermes/3.2 (Subdomain Recon)" ascii
        $ua5 = "Cybermes-AIGateway-Auditor/" ascii
        $ua6 = "Cybermes-ExamAuditor/" ascii
        $ua7 = "cybermes-mcp-updater/" ascii
        $m1 = "cybermes/pkg/mcp" ascii
        $m2 = "Cybermes MCP Server v" ascii
        $m3 = "[cybermes-mcp] " ascii
        $t1 = "cybermes_fuzz_endpoints" ascii
        $t2 = "cybermes_recon_crawl" ascii
        $t3 = "cybermes_nuclei_scan" ascii
        $t4 = "cybermes_record_finding" ascii
        $t5 = "cybermes_validate_scope" ascii
    condition:
        filesize < 80MB and (any of ($ua*) or 2 of ($m*) or 3 of ($t*))
}

rule Cybermes_Assessment_Report
{
    meta:
        description = "Cybermes HTML assessment report (reports/<target_slug>/report.html from cybermes-mcp, or the HTML that tools/generate_pdf.py renders to REPORT_<target_slug>.pdf), or its SUMMARY.md: findings, PoCs and evidence for one target"
        mitre_att = "T1595.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/Zyrexnn/Cybermes/blob/149b9a66752244bbb78926dcdc94dfc5b647ed80/pkg/report/html_template.go"
        confidence = "medium"
    strings:
        $h1 = "<div class=\"brand-tag\">Cybermes Security Assessment</div>" ascii
        $h2 = "Generated by Cybermes Offensive Security & Bug Bounty Framework" ascii
        $h3 = "<div class=\"brand-tag\">Cybermes Offensive Security Platform</div>" ascii
        $h4 = "Generated autonomously by <strong>Cybermes Security Intelligence</strong>" ascii
        $s1 = "# \xF0\x9F\x9B\xA1\xEF\xB8\x8F Security Assessment Summary: `" ascii
        $s2 = "## \xF0\x9F\xA7\xAA Proof of Concept Scripts (`pocs/`)" ascii
        $s3 = "## \xF0\x9F\x93\x81 Evidence & Recon Notes (`evidence/`)" ascii
    condition:
        filesize < 20MB and (any of ($h*) or 2 of ($s*))
}
