// Indicator sweep with the agentic watchlist
// Agentic attack detections by ThreatDefence (Cybermes). Source: https://github.com/ThreatDefence/agentic-attack-detections
// ATT&CK: T1594 (Search Victim-Owned Websites), T1588.002 (Obtain Capabilities: Tool)
// Upload feeds/sentinel-watchlist.csv as a Microsoft Sentinel watchlist with the alias AGENTIC_IOCs and the search key
// "value". A match needs investigation. Cybermes has no addresses, C2 or console of its own: its rows are user agents,
// command-line strings, file names and paths, its Docker image and the model gateway its README promotes (low confidence).
// Hermes rows (framework hermes) apply too, because Cybermes runs Hermes.

let IOC = _GetWatchlist('AGENTIC_IOCs') | where framework has "cybermes" | project value=tostring(SearchKey), type, confidence, actor, source;
let UAs = toscalar(IOC | where type == "user_agent" | summarize make_list(value));
let Domains = toscalar(IOC | where type == "domain" | summarize make_list(value));
let Files = toscalar(IOC | where type == "file_name" | summarize make_list(value));
let Paths = toscalar(IOC | where type == "file_path" | summarize make_list(value));
let Strings = toscalar(IOC | where type in ("string", "docker_image") and confidence == "high" | summarize make_list(value));
union isfuzzy=true
    (CommonSecurityLog | where TimeGenerated > ago(90d)
        | where RequestClientApplication in (UAs) or DestinationHostName has_any (Domains)
        | project TimeGenerated, Source="CommonSecurityLog", Detail=strcat(SourceIP, " ", RequestURL),
            Indicator=iff(RequestClientApplication in (UAs), RequestClientApplication, DestinationHostName)),
    (W3CIISLog | where TimeGenerated > ago(90d)
        | extend UA=replace_string(csUserAgent, "+", " ")
        | where UA in (UAs)
        | project TimeGenerated, Source="W3CIISLog", Indicator=UA, Detail=strcat(cIP, " ", csUriStem)),
    (DeviceNetworkEvents | where Timestamp > ago(30d)
        | where RemoteUrl has_any (Domains)
        | project TimeGenerated=Timestamp, Source="DeviceNetworkEvents", Indicator=RemoteUrl,
            Detail=strcat(DeviceName, " ", InitiatingProcessFileName, " ", substring(InitiatingProcessCommandLine, 0, 150))),
    (DnsEvents | where TimeGenerated > ago(90d)
        | where Name has_any (Domains)
        | project TimeGenerated, Source="DnsEvents", Indicator=Name, Detail=ClientIP),
    (DeviceFileEvents | where Timestamp > ago(30d)
        | where FileName in~ (Files) or FolderPath has_any (Paths)
        | project TimeGenerated=Timestamp, Source="DeviceFileEvents", Indicator=FileName, Detail=strcat(DeviceName, " ", FolderPath)),
    (DeviceProcessEvents | where Timestamp > ago(30d)
        | where ProcessCommandLine has_any (Strings)
        | project TimeGenerated=Timestamp, Source="DeviceProcessEvents", Indicator="Cybermes string in command line",
            Detail=strcat(DeviceName, " ", substring(ProcessCommandLine, 0, 200)))
| join kind=leftouter (IOC) on $left.Indicator == $right.value
| summarize Events=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), Details=make_set(Detail, 10)
    by Source, Indicator, actor, confidence
| order by LastSeen desc
