rule DarkMoon_Source_Or_Image
{
    meta:
        description = "DarkMoon source, agent prompts or container image layer: MCP server name and banner, orchestrator tag, prompt header, sockets and Docker client"
        mitre_att = "T1588.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/ASCIT31/Dark-Moon"
        confidence = "high"
    strings:
        $mcp_name = "FastMCP(\"Darkmoon CyberSecurity\")" ascii
        $orchestrator = "<mcp_darkmoon_mandatory>" ascii
        $header = { 53 54 41 54 55 53 20 51 55 41 4C 49 46 49 43 41 54 49 4F 4E 20 E2 80 94 20 44 41 52 4B 4D 4F 4F 4E }  // STATUS QUALIFICATION — DARKMOON
        $stream = "/tmp/darkmoon_mcp_stream" ascii
        $privacy_sock = "/tmp/darkmoon-privacy.sock" ascii
        $client = "class DarkmoonDockerClient" ascii
        $banner = "print(\"Darkmoon MCP Server\")" ascii
        $tool = "darkmoon_execute_command(command=" ascii
    condition:
        filesize < 200MB and 2 of them
}

rule DarkMoon_Report
{
    meta:
        description = "DarkMoon Markdown penetration test report (schema darkmoon-report/v2)"
        mitre_att = "T1588.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/ASCIT31/Dark-Moon"
        confidence = "high"
    strings:
        $footer = "*Report generated by Darkmoon from the campaign data (darkmoon-report/v2).*" ascii
    condition:
        filesize < 50MB and $footer
}

rule DarkMoon_Provider_Config
{
    meta:
        description = "DarkMoon .opencode.env written by install.sh (model provider, model and API key)"
        mitre_att = "T1588.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/ASCIT31/Dark-Moon"
        confidence = "high"
    strings:
        $cloud = { 23 20 44 61 72 6B 6D 6F 6F 6E 20 E2 80 94 20 4C 4C 4D 20 63 6C 6F 75 64 20 70 72 6F 76 69 64 65 72 20 63 6F 6E 66 69 67 }  // # Darkmoon — LLM cloud provider config
        $onprem = { 23 20 44 61 72 6B 6D 6F 6F 6E 20 E2 80 94 20 6F 6E 2D 70 72 65 6D 20 41 6E 74 68 72 6F 70 69 63 }  // # Darkmoon — on-prem Anthropic
        $local = { 23 20 44 61 72 6B 6D 6F 6F 6E 20 E2 80 94 20 4C 4C 4D 20 6C 6F 63 61 6C 20 70 72 6F 76 69 64 65 72 20 63 6F 6E 66 69 67 }  // # Darkmoon — LLM local provider config
        $gen = "# Generated by install.sh on " ascii
    condition:
        filesize < 64KB and $gen and any of ($cloud, $onprem, $local)
}
