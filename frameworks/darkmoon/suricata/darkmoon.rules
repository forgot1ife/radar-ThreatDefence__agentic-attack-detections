# Agentic attack detections by ThreatDefence: DarkMoon
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3812901-3812949. Strings from ASCIT31/Dark-Moon at bb1b70ce (agent prompts in conf/agents/).

# --- Probes written out in the agent prompts (the model usually copies them; it may change them) ---
alert http any any -> any any (msg:"TD DarkMoon edge agent user agent dm-edge"; flow:established,to_server; http.user_agent; content:"dm-edge"; startswith; endswith; fast_pattern; classtype:web-application-attack; sid:3812901; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family DarkMoon, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD DarkMoon cache poisoning probe X-Forwarded-Host dm-poison.invalid"; flow:established,to_server; http.header; content:"X-Forwarded-Host|3a 20|dm-poison.invalid"; nocase; fast_pattern; classtype:web-application-attack; sid:3812902; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family DarkMoon, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> any any (msg:"TD DarkMoon cache buster dmcb=DM1"; flow:established,to_server; http.uri; content:"dmcb=DM1"; fast_pattern; classtype:web-application-attack; sid:3812903; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family DarkMoon, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert tcp any any -> any [25,587,2525] (msg:"TD DarkMoon email agent SMTP greeting EHLO dm-test.local"; flow:established,to_server; content:"EHLO dm-test.local|0d 0a|"; nocase; fast_pattern; classtype:attempted-recon; sid:3812904; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family DarkMoon, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert tcp any any -> any [25,587,2525] (msg:"TD DarkMoon email agent SMTP user enumeration VRFY dm-nosuchuser-9182"; flow:established,to_server; content:"VRFY dm-nosuchuser-9182|0d 0a|"; nocase; fast_pattern; classtype:attempted-recon; sid:3812905; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family DarkMoon, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1589.002, mitre_technique_name Email_Addresses;)
alert tcp any any -> any [25,587,2525] (msg:"TD DarkMoon email agent relay or spoofing test message"; flow:established,to_server; content:"Subject|3a| DM "; fast_pattern; pcre:"/Subject: DM (RELAY|SPOOF) TEST\r\n/"; classtype:attempted-recon; sid:3812906; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family DarkMoon, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD DarkMoon container registry push proof tag darkmoon-proof-"; flow:established,to_server; http.uri; content:"/manifests/darkmoon-proof-"; fast_pattern; classtype:web-application-attack; sid:3812907; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family DarkMoon, mitre_tactic_id TA0003, mitre_tactic_name Persistence, mitre_technique_id T1525, mitre_technique_name Implant_Internal_Image;)
alert http any any -> any any (msg:"TD DarkMoon SCIM write proof user darkmoon-test"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/scim/v2/"; nocase; http.request_body; content:"darkmoon-test"; fast_pattern; classtype:web-application-attack; sid:3812908; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family DarkMoon, mitre_tactic_id TA0003, mitre_tactic_name Persistence, mitre_technique_id T1136.003, mitre_technique_name Cloud_Account;)

# --- From the host that runs DarkMoon ---
alert http $HOME_NET any -> any any (msg:"TD DarkMoon placeholder model API key darkmoon-local"; flow:established,to_server; http.header; content:"x-api-key|3a 20|darkmoon-local"; nocase; fast_pattern; classtype:policy-violation; sid:3812910; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family DarkMoon, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- The DarkMoon MCP server (loopback by default; on the wire only when an operator publishes it) ---
alert http any any -> any any (msg:"TD DarkMoon MCP server initialize answer (Darkmoon CyberSecurity)"; flow:established,to_client; http.response_body; content:"serverInfo"; content:"Darkmoon CyberSecurity"; fast_pattern; classtype:policy-violation; sid:3812911; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family DarkMoon, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD DarkMoon MCP server tool list"; flow:established,to_client; http.response_body; content:"dashboard_push_finding"; fast_pattern; content:"dashboard_init_campaign"; classtype:policy-violation; sid:3812912; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family DarkMoon, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD DarkMoon MCP tool call pushing a finding"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"tools/call"; content:"dashboard_push_finding"; fast_pattern; classtype:policy-violation; sid:3812913; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family DarkMoon, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
