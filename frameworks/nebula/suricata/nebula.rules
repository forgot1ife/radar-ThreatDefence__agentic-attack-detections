# Agentic attack detections by ThreatDefence: Nebula
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3818501-3818549. HTTP rules need cleartext HTTP or decrypted traffic.
# The core is plain HTTP unless the operator passes --tls-cert and --tls-key; pairing and the terminal client use HTTPS
# unless plain HTTP was allowed.

# --- Its own requests ---
alert http any any -> any any (msg:"TD Nebula terminal client user agent (nebula-chat to a remote core)"; flow:established,to_server; http.user_agent; content:"nebula-chat"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3818501; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Nebula, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Nebula Kali container public address check"; flow:established,to_server; http.user_agent; content:"Nebula-Terminal/1"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3818502; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Nebula, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1016, mitre_technique_name System_Network_Configuration_Discovery;)
alert http any any -> any any (msg:"TD Nebula knowledge source fetcher or renderer user agent"; flow:established,to_server; http.user_agent; content:"Nebula/3 knowledge-source-"; startswith; fast_pattern; classtype:policy-violation; sid:3818503; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Nebula, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Paired clients and tool callbacks to a core ---
alert http any any -> any any (msg:"TD Nebula paired-device CSRF header in a request"; flow:established,to_server; http.header; content:"X-Nebula-CSRF|3a|"; nocase; fast_pattern; classtype:policy-violation; sid:3818504; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Nebula, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Nebula paired-device cookie in a request"; flow:established,to_server; http.cookie; content:"nebula_device="; fast_pattern; classtype:policy-violation; sid:3818505; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Nebula, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Nebula device pairing redeemed on a core"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/v1/auth/pairings/redeem"; startswith; fast_pattern; classtype:policy-violation; sid:3818506; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Nebula, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1133, mitre_technique_name External_Remote_Services;)
alert http any any -> any any (msg:"TD Nebula background tool result posted to its core"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/v1/automation-processes/"; startswith; content:"/results"; endswith; http.header; content:"X-Nebula-Api-Key|3a|"; nocase; fast_pattern; classtype:policy-violation; sid:3818507; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Nebula, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- An exposed workspace or core ---
alert http any any -> any any (msg:"TD Nebula browser workspace page"; flow:established,to_client; http.response_body; content:"Nebula 3 local-first security engagement workspace"; fast_pattern; content:"<title>Nebula 3</title>"; classtype:policy-violation; sid:3818510; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Nebula, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Nebula core placeholder page (container, headless or no workspace build)"; flow:established,to_client; http.response_body; content:"Nebula Core is running. Connect with a paired client."; fast_pattern; classtype:policy-violation; sid:3818511; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Nebula, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Nebula workspace web manifest"; flow:established,to_client; http.response_body; content:"|22|Nebula Operator Companion|22|"; fast_pattern; classtype:policy-violation; sid:3818512; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Nebula, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
