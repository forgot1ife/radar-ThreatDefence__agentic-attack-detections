alert http any any -> any any (msg:"TD Nebula core operator-only API refusal"; flow:established,to_client; http.stat_code; content:"401"; http.response_body; content:"|22|detail|22 3a 22|local bearer authentication required|22|"; fast_pattern; classtype:policy-violation; sid:3818514; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Nebula, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Nebula core refusing a remote device pairing"; flow:established,to_client; http.response_body; content:"new device pairings may be created only from the local machine"; fast_pattern; classtype:policy-violation; sid:3818515; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Nebula, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1133, mitre_technique_name External_Remote_Services;)
