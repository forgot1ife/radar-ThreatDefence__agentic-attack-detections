# Agentic attack detections by ThreatDefence: BreachWeave
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3819301-3819349. Strings from m-sec-org/BreachWeave at bc2d9502 (main, package tch-agent)
# and 6957a55f (pentest branch, product name BreachWeave). The web console is plain HTTP (Bun.serve, 127.0.0.1:3000 by
# default, rebound with web -l host:port). Model and search requests go over TLS to the provider unless the operator
# points them at a plain-HTTP gateway, so the model-traffic rules see them only on such a gateway or behind a TLS-inspecting
# proxy. Chinese prompt text is matched as UTF-8 bytes (JSON.stringify does not escape it).

# --- An exposed BreachWeave web console (no authentication on main; JWT with open self-registration on pentest) ---
alert http any any -> any any (msg:"TD BreachWeave web console page (tch-agent title, main branch)"; flow:established,to_client; http.response_body; content:"<title>tch-agent</title>"; fast_pattern; classtype:policy-violation; sid:3819301; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family BreachWeave, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
