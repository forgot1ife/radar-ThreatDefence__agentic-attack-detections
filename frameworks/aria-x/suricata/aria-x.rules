# Agentic attack detections by ThreatDefence: ARIA-X
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3819401-3819449. HTTP rules need cleartext HTTP or decrypted traffic.
# From the ARIA-X source code (01NGVI-QINGYI/ARIA-X, reviewed at 015e197, v0.3.0). The console and API are plain HTTP
# on port 8787 with no TLS option, so the console rules work without decryption. The middle dot in the console title is
# U+00B7, matched as the UTF-8 bytes C2 B7.

# --- Requests that reach your targets ---
alert http any any -> $HTTP_SERVERS any (msg:"TD ARIA-X agent user agent"; flow:established,to_server; http.user_agent; content:"ARIA-X/"; startswith; fast_pattern; content:" (authorized security research)"; distance:0; endswith; classtype:web-application-attack; sid:3819401; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family ARIA-X, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)

# --- The ARIA-X console and API (exposed server, or a browser or script driving one) ---
alert http any any -> any any (msg:"TD ARIA-X console page title"; flow:established,to_client; http.response_body; content:"<title>ARIA-X |C2 B7| Engagement Console</title>"; fast_pattern; classtype:policy-violation; sid:3819410; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family ARIA-X, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD ARIA-X console Server header"; flow:established,to_client; http.server; content:"ARIA-X/"; startswith; fast_pattern; classtype:policy-violation; sid:3819411; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family ARIA-X, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD ARIA-X API bearer realm on 401"; flow:established,to_client; http.stat_code; content:"401"; http.header; content:"WWW-Authenticate|3a 20|Bearer realm=|22|ARIA-X|22|"; fast_pattern; classtype:policy-violation; sid:3819412; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family ARIA-X, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD ARIA-X API configuration response"; flow:established,to_client; http.response_body; content:"|22|tagline|22 3a 20 22|Autonomous Reasoning & Investigation Agent, eXtended|22|"; fast_pattern; classtype:policy-violation; sid:3819413; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family ARIA-X, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD ARIA-X API configuration says no authentication is required"; flow:established,to_client; http.response_body; content:"|22|auth_required|22 3a 20|false"; fast_pattern; content:"|22|tagline|22 3a 20 22|Autonomous Reasoning & Investigation Agent"; classtype:policy-violation; sid:3819414; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family ARIA-X, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> any any (msg:"TD ARIA-X engagement created through the console API"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/projects"; startswith; endswith; http.request_body; content:"|22|scope|22 3a 7b 22|authorized|22 3a|true,|22|targets|22 3a 5b|"; fast_pattern; content:"|22|deny|22 3a 5b 5d 2c 22|allow_private|22 3a|true,|22|allow_loopback|22 3a|true|7d|"; distance:0; classtype:attempted-admin; sid:3819415; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family ARIA-X, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
