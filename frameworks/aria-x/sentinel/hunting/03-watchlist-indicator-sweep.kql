// Indicator sweep with the agentic watchlist
// Agentic attack detections by ThreatDefence (ARIA-X). Source: https://github.com/ThreatDefence/agentic-attack-detections
// ATT&CK: T1588.002 (Obtain Capabilities: Tool), T1595.002 (Active Scanning: Vulnerability Scanning)
// Upload feeds/sentinel-watchlist.csv as a Microsoft Sentinel watchlist with the alias AGENTIC_IOCs and the search key
// "value". A match needs investigation.
// No ARIA-X infrastructure has been published, so these rows are fingerprints of the software: its user agents,
// console strings, file and container names, and the model host its shipped configuration uses.

let IOC = _GetWatchlist('AGENTIC_IOCs') | where framework has "aria-x" | project value=tostring(SearchKey), type, confidence, actor, source;
let Domains = toscalar(IOC | where type == "domain" | summarize make_list(value));
let Agents = toscalar(IOC | where type == "user_agent" | summarize make_list(value));
let Names = toscalar(IOC | where type in ("file_name", "file_path", "docker_image") or (type == "string" and confidence == "high") | summarize make_list(value));
union isfuzzy=true
    (CommonSecurityLog | where TimeGenerated > ago(90d)
        | where DestinationHostName has_any (Domains) or RequestClientApplication in (Agents)
        | project TimeGenerated, Source="CommonSecurityLog", Indicator=iff(RequestClientApplication in (Agents), RequestClientApplication, DestinationHostName), Detail=strcat(SourceIP, " ", RequestURL)),
    (W3CIISLog | where TimeGenerated > ago(90d)
        | extend UA=replace_string(csUserAgent, "+", " ")
        | where UA in (Agents)
        | project TimeGenerated, Source="W3CIISLog", Indicator=UA, Detail=strcat(cIP, " ", csHost, csUriStem)),
    (DeviceNetworkEvents | where Timestamp > ago(30d)
        | where RemoteUrl has_any (Domains)
        | project TimeGenerated=Timestamp, Source="DeviceNetworkEvents", Indicator=RemoteUrl, Detail=strcat(DeviceName, " ", InitiatingProcessFileName)),
    (DeviceProcessEvents | where Timestamp > ago(30d)
        | where ProcessCommandLine has_any (Names)
        | project TimeGenerated=Timestamp, Source="DeviceProcessEvents", Indicator=substring(ProcessCommandLine, 0, 200), Detail=DeviceName),
    (DeviceFileEvents | where Timestamp > ago(30d)
        | where FolderPath has_any (Names)
        | project TimeGenerated=Timestamp, Source="DeviceFileEvents", Indicator=FolderPath, Detail=DeviceName),
    (DnsEvents | where TimeGenerated > ago(90d)
        | where Name has_any (Domains)
        | project TimeGenerated, Source="DnsEvents", Indicator=Name, Detail=ClientIP)
| summarize Events=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), Details=make_set(Detail, 10)
    by Source, Indicator
| order by LastSeen desc
