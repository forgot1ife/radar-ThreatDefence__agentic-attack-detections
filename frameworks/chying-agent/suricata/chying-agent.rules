# Agentic attack detections by ThreatDefence: CHYing-agent
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3817701-3817749. Strings from yhy0/CHYing-agent at 0d2ee81f.
# The dashboard is plain HTTP on 8080. Web terminal rules need cleartext ws:// or decrypted wss://. Model traffic rules need TLS inspection.

# --- A target's web terminal driven by the agent (wss_connect / wss_exec). The markers come back in the terminal output;
# --- client frames are masked, so the rules look at what the server sends. GoTTY base64-encodes its output and is not covered.
alert tcp any any -> any any (msg:"TD CHYing-agent web terminal probe marker in terminal output"; flow:established,to_client; content:"__WSS_PROBE_7b3e__"; fast_pattern; classtype:attempted-admin; sid:3817701; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family CHYing-agent, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1133, mitre_technique_name External_Remote_Services, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059.004, mitre_technique_name Unix_Shell;)
alert tcp any any -> any any (msg:"TD CHYing-agent web terminal exit-code marker in terminal output"; flow:established,to_client; content:"__WSS_EXIT_c1a4__"; fast_pattern; classtype:attempted-admin; sid:3817702; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family CHYing-agent, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059.004, mitre_technique_name Unix_Shell;)
alert tcp any any -> any any (msg:"TD CHYing-agent web terminal command delimiter in terminal output"; flow:established,to_client; content:"__WSS_CMD_END_9f7a__"; fast_pattern; classtype:attempted-admin; sid:3817703; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family CHYing-agent, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059.004, mitre_technique_name Unix_Shell;)

# --- An exposed CHYing-agent dashboard (0.0.0.0:8080, no login) ---
alert http any any -> any any (msg:"TD CHYing-agent dashboard page or Swagger page title"; flow:established,to_client; http.response_body; content:"<title>CHYing Agent Dashboard"; fast_pattern; classtype:policy-violation; sid:3817704; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family CHYing-agent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD CHYing-agent dashboard OpenAPI document"; flow:established,to_client; http.response_body; content:"Web Dashboard API for CHYing Agent"; fast_pattern; classtype:policy-violation; sid:3817705; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family CHYing-agent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD CHYing-agent dashboard statistics API answer"; flow:established,to_client; http.response_body; content:"|22|total_discoveries|22 3a|"; content:"|22|total_writeups|22 3a|"; fast_pattern; content:"|22|recent_executions|22 3a|"; classtype:policy-violation; sid:3817706; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family CHYing-agent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Model requests from the host that runs CHYing-agent (TLS inspection needed) ---
alert http $HOME_NET any -> any any (msg:"TD CHYing-agent orchestrator system prompt in a model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"You are CHYing Orchestrator - an autonomous security automation system"; fast_pattern; classtype:policy-violation; sid:3817707; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family CHYing-agent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> any any (msg:"TD CHYing-agent tool names in a model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"mcp__chying__exec"; fast_pattern; content:"mcp__chying__record_key_finding"; classtype:policy-violation; sid:3817708; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family CHYing-agent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
