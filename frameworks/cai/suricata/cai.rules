# Agentic attack detections by ThreatDefence: CAI (Cybersecurity AI, Alias Robotics)
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3816001-3816499. DNS and TLS SNI rules work on encrypted traffic; HTTP rules on the
# Alias hosts need TLS inspection. The CAI API (cai --api, uvicorn, 8000 by default) is plain HTTP.

# --- CAI telemetry: the session log upload to logs.aliasrobotics.com ---
alert dns $HOME_NET any -> any any (msg:"TD CAI telemetry DNS query (logs.aliasrobotics.com)"; dns.query; dotprefix; content:".logs.aliasrobotics.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3816001; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family CAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"TD CAI telemetry TLS (logs.aliasrobotics.com)"; flow:established,to_server; tls.sni; dotprefix; content:".logs.aliasrobotics.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3816002; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family CAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD CAI telemetry session log upload"; flow:established,to_server; http.method; content:"POST"; http.host; content:"logs.aliasrobotics.com"; startswith; http.uri; content:"/upload"; startswith; fast_pattern; classtype:policy-violation; sid:3816003; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family CAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD CAI session log file in a multipart upload"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"name=|22|log|22 3b 20|filename=|22|cai_"; fast_pattern; content:".jsonl|22|"; distance:0; classtype:policy-violation; sid:3816004; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family CAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Alias gateway (default model alias1 and the licence check, TCP 666 and 665) and private package index (TCP 664) ---
alert dns $HOME_NET any -> any any (msg:"TD CAI Alias model and licence gateway DNS query (api.aliasrobotics.com)"; dns.query; dotprefix; content:".api.aliasrobotics.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3816010; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family CAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"TD CAI Alias model and licence gateway TLS (api.aliasrobotics.com)"; flow:established,to_server; tls.sni; dotprefix; content:".api.aliasrobotics.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3816011; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family CAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert dns $HOME_NET any -> any any (msg:"TD CAI private package index DNS query (packages.aliasrobotics.com)"; dns.query; dotprefix; content:".packages.aliasrobotics.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3816012; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family CAI, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"TD CAI private package index TLS (packages.aliasrobotics.com)"; flow:established,to_server; tls.sni; dotprefix; content:".packages.aliasrobotics.com"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3816013; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family CAI, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD CAI licence check (GET /key/info on api.aliasrobotics.com)"; flow:established,to_server; http.method; content:"GET"; http.host; content:"api.aliasrobotics.com"; startswith; http.uri; content:"/key/info"; startswith; fast_pattern; http.header; content:"Authorization|3a 20|Bearer "; nocase; classtype:policy-violation; sid:3816014; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family CAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Requests that reach your sites: the fetch_url tool ---
alert http any any -> $HTTP_SERVERS any (msg:"TD CAI fetch_url user agent (two-part Chrome/124.0 version)"; flow:established,to_server; http.user_agent; content:"Chrome/124.0 Safari/537.36"; endswith; fast_pattern; content:"Mozilla/5.0 (X11|3b| Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) "; startswith; classtype:web-application-activity; sid:3816020; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family CAI, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1594, mitre_technique_name Search_Victim-Owned_Websites;)

# --- An exposed CAI API (cai --api) ---
alert http any any -> any any (msg:"TD CAI API tag discovery response"; flow:established,to_client; http.response_body; content:"|22|tags|22 3a 5b 22|meta|22 2c 22|auth|22 2c 22|catalog|22 2c 22|sessions|22 2c 22|inference|22 2c 22|commands|22 2c 22|ux|22 5d|"; fast_pattern; classtype:policy-violation; sid:3816030; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family CAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD CAI API OpenAPI description"; flow:established,to_client; http.response_body; content:"Backend HTTP state for the Cybersecurity AI Framework"; fast_pattern; classtype:policy-violation; sid:3816031; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family CAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD CAI API key header"; flow:established,to_server; http.header; content:"X-CAI-API-Key|3a|"; nocase; fast_pattern; classtype:policy-violation; sid:3816032; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family CAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD CAI API device pairing (POST /api/v1/auth/add-ip)"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/v1/auth/add-ip"; startswith; fast_pattern; classtype:policy-violation; sid:3816033; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family CAI, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
