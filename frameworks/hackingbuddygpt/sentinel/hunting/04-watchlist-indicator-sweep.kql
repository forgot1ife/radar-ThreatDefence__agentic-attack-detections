// Indicator sweep with the agentic watchlist
// Agentic attack detections by ThreatDefence (hackingBuddyGPT). Source: https://github.com/ThreatDefence/agentic-attack-detections
// ATT&CK: T1595 (Active Scanning), T1059 (Command and Scripting Interpreter)
// Upload feeds/sentinel-watchlist.csv as a Microsoft Sentinel watchlist with the alias AGENTIC_IOCs and the search key
// "value". A match needs investigation.
// hackingBuddyGPT has no operator addresses or domains: its rows are strings, paths and file names from the code, so
// this sweep looks for them in URLs and command lines.

let IOC = _GetWatchlist('AGENTIC_IOCs') | where framework has "hackingbuddygpt" | project value=tostring(SearchKey), type, confidence, actor, source;
let Strings = toscalar(IOC | where type in ("string", "uri_string", "file_path", "docker_image") and confidence in ("high", "medium") | summarize make_list(value));
let Domains = toscalar(IOC | where type == "domain" | summarize make_list(value));
union isfuzzy=true
    (CommonSecurityLog | where TimeGenerated > ago(90d)
        | where RequestURL has_any (Strings) or DestinationHostName has_any (Domains)
        | project TimeGenerated, Source="CommonSecurityLog", Indicator=iff(DestinationHostName has_any (Domains), DestinationHostName, RequestURL),
            Detail=strcat(SourceIP, " ", RequestClientApplication)),
    (W3CIISLog | where TimeGenerated > ago(90d)
        | extend Url=strcat(csUriStem, "?", csUriQuery)
        | where Url has_any (Strings)
        | project TimeGenerated, Source="W3CIISLog", Indicator=Url, Detail=strcat(cIP, " ", csUriStem)),
    (DeviceProcessEvents | where Timestamp > ago(30d)
        | where ProcessCommandLine has_any (Strings)
        | project TimeGenerated=Timestamp, Source="DeviceProcessEvents", Indicator=substring(ProcessCommandLine, 0, 200),
            Detail=strcat(DeviceName, " ", AccountName)),
    (DeviceFileEvents | where Timestamp > ago(30d)
        | where FolderPath has_any (Strings)
        | project TimeGenerated=Timestamp, Source="DeviceFileEvents", Indicator=FolderPath, Detail=DeviceName)
| summarize Events=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), Details=make_set(Detail, 10)
    by Source, Indicator
| order by LastSeen desc
