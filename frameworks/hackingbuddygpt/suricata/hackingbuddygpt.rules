# Agentic attack detections by ThreatDefence: hackingBuddyGPT
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3813101-3813115. HTTP rules need cleartext HTTP or decrypted traffic.
# hackingBuddyGPT has no web console or listener, so every rule here is about traffic that reaches a target.
# Its requests use Python requests' default user agent, so these rules key on values in its code.

# --- WebAPITesting discovery: values the code appends in its query step (detection_response_handler.py:400-428,480-481) ---
alert http any any -> $HTTP_SERVERS any (msg:"TD hackingBuddyGPT WebAPITesting discovery query api_key=YourAPIKeyHere"; flow:established,to_server; http.uri; content:"api_key=YourAPIKeyHere"; fast_pattern; classtype:attempted-recon; sid:3813101; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family hackingBuddyGPT, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.003, mitre_technique_name Wordlist_Scanning;)
alert http any any -> $HTTP_SERVERS any (msg:"TD hackingBuddyGPT WebAPITesting discovery query access_token=YourAccessToken"; flow:established,to_server; http.uri; content:"access_token=YourAccessToken"; fast_pattern; classtype:attempted-recon; sid:3813102; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family hackingBuddyGPT, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.003, mitre_technique_name Wordlist_Scanning;)
# A missing comma in the common-path list joins '/products/{id}' and '/users/profile' (detection_response_handler.py:59-60); {id} becomes 1 (:249).
alert http any any -> $HTTP_SERVERS any (msg:"TD hackingBuddyGPT WebAPITesting joined discovery path /products/1/users/profile"; flow:established,to_server; http.uri; content:"/products/1/users/profile"; fast_pattern; classtype:attempted-recon; sid:3813103; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family hackingBuddyGPT, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.003, mitre_technique_name Wordlist_Scanning;)

# --- WebAPITesting test steps given to the model (code (prompt): the model may reword them) ---
# OTP brute force against the crAPI victim account (_pentesting_auth.py:526-545). A crAPI walkthrough sends the same values.
alert http any any -> $HTTP_SERVERS any (msg:"TD hackingBuddyGPT WebAPITesting OTP brute force with the crAPI victim account"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"adam007@example.com"; fast_pattern; content:"Az123###"; classtype:attempted-user; sid:3813104; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family hackingBuddyGPT, mitre_tactic_id TA0006, mitre_tactic_name Credential_Access, mitre_technique_id T1110.001, mitre_technique_name Password_Guessing;)
# SQL injection on login with the tool's account counter field "x" (_pentesting_injection.py:181).
alert http any any -> $HTTP_SERVERS any (msg:"TD hackingBuddyGPT WebAPITesting login SQL injection with x counter field"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"' or 1=1--"; fast_pattern; content:"|22|password|22|"; content:"|22|x|22|"; classtype:web-application-attack; sid:3813105; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family hackingBuddyGPT, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
# XSS probe in the e-mail field (_pentesting_injection.py:314).
alert http any any -> $HTTP_SERVERS any (msg:"TD hackingBuddyGPT WebAPITesting XSS2 probe in e-mail field"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"XSS2"; fast_pattern; content:"<script>alert("; content:"|22|email|22|"; classtype:web-application-attack; sid:3813106; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family hackingBuddyGPT, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)

# --- Linux privilege-escalation use-cases: SSH from asyncssh (ssh_interactive_connection.py:66-87) ---
# The client version string is asyncssh's default (inferred from the library). Other asyncssh-based tools send it too.
alert ssh any any -> $HOME_NET 22 (msg:"TD SSH login from an asyncssh client (hackingBuddyGPT, Cochise and other asyncssh tools)"; flow:established,to_server; ssh.software; content:"AsyncSSH_"; startswith; fast_pattern; classtype:policy-violation; sid:3813107; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family hackingBuddyGPT, mitre_tactic_id TA0008, mitre_tactic_name Lateral_Movement, mitre_technique_id T1021.004, mitre_technique_name SSH;)
