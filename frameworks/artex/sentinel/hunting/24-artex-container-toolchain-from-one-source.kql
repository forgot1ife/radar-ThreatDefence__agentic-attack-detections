// The ARTEX container toolchain seen from one source
// Agentic attack detections by ThreatDefence (ARTEX). Source: https://threatdefence.com/article/artex-agentic-attack-framework-detection-hunting
// ATT&CK: T1595.002 (Active Scanning: Vulnerability Scanning)
// Example hunt for Microsoft Sentinel. Test and baseline before alerting. Refines shared behavior hunt 20.
// From the ARTEX source code. The image is always built from the repository Dockerfile, on Debian bookworm, with pinned
// tools: sqlmap 1.9.9, ffuf v2.3.0, nuclei v3.11.1, httpx v1.12.0, katana v1.8.0, dalfox v3.2.4, bbot 3.0.2, nmap from
// apt and Playwright 1.64.1 with headless Chromium (Dockerfile:71-220). Next to the scanners sit ARTEX's own clients:
// WebFetch ("norma/0.4"), the enrichment probe ("Go-http-client/1.1"), the api-recon skill scripts
// ("Mozilla/5.0 (spa-api-recon)" and "Mozilla/5.0 (spa-api-recon spider)", skills/api-recon/scripts/harvest_static.py:23,
// spider_mpa.py:22) and bookworm's curl 7.88.1 and Wget 1.21.3. Shared behavior hunt 20 counts any user agent families. This one scores
// the specific clients the ARTEX image carries, so three or more of them from one address in an hour is a much narrower
// lead. Each scanner user agent can be changed with a flag, the bookworm versions change with the base image, and
// "norma/0.4" and "spa-api-recon" need a code change.

let Window = 14d;
let Clients = (ua:string) { case(
    ua == "norma/0.4", "norma WebFetch",
    ua == "Go-http-client/1.1", "Go enrichment probe",
    ua has "spa-api-recon", "api-recon skill",
    ua startswith "sqlmap/1.9", "sqlmap 1.9",
    ua has "Fuzz Faster U Fool", "ffuf",
    ua has "Nmap Scripting Engine", "nmap NSE",
    ua has "HeadlessChrome", "headless Chromium",
    ua == "curl/7.88.1", "bookworm curl",
    ua == "Wget/1.21.3", "bookworm wget",
    ua startswith "python-requests/" or ua startswith "Python-urllib/3.12", "Python 3.12 clients",
    "") };
union isfuzzy=true
    (CommonSecurityLog | where TimeGenerated > ago(Window) and isnotempty(RequestClientApplication)
        | project TimeGenerated, Src=SourceIP, Host=DestinationHostName, UA=RequestClientApplication),
    (W3CIISLog | where TimeGenerated > ago(Window)
        | project TimeGenerated, Src=cIP, Host=csHost, UA=replace_string(csUserAgent, "+", " "))
| where not(ipv4_is_private(Src)) and Src != "127.0.0.1"
| extend Client = Clients(UA)
| where isnotempty(Client)
| summarize Requests=count(), Clients=dcount(Client), ClientList=make_set(Client), Hosts=make_set(Host, 10),
    SampleUAs=make_set(UA, 10) by Src, bin(TimeGenerated, 1h)
| where Clients >= 3
// The ARTEX-specific clients weigh more than the generic ones.
| extend Specific = set_intersect(ClientList, dynamic(["norma WebFetch", "api-recon skill", "Go enrichment probe"]))
| summarize Hours=count(), TotalRequests=sum(Requests), MaxClients=max(Clients), ClientList=make_set(ClientList),
    Specific=make_set(Specific), Hosts=make_set(Hosts, 20), SampleUAs=make_set(SampleUAs, 20),
    FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by Src
| order by array_length(Specific) desc, MaxClients desc, TotalRequests desc
