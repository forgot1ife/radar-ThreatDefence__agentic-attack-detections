// AntiFox intrusion pattern: an IIS web shell, web.config theft, then AWS enumeration from hosting infrastructure
// Agentic attack detections by ThreatDefence (ARTEX, AntiFox fork). Source: https://github.com/ThreatDefence/agentic-attack-detections
// ATT&CK: T1505.003 (Server Software Component: Web Shell), T1552.001 (Unsecured Credentials: Credentials In Files), T1580 (Cloud Infrastructure Discovery)
// Example hunt for Defender XDR advanced hunting and Microsoft Sentinel with AWS CloudTrail. Test and baseline before alerting.
// Arctic Wolf Labs (November 10, 2026) tied AntiFox consoles on Alibaba Cloud (47.79.4.33, 8.208.101.210) to intrusions:
//  - w3wp.exe wrote an ASPX web shell (pwn*.aspx) into an upload folder and started cmd.exe, powershell.exe, where.exe,
//    whoami.exe and icacls.exe to check the user, list the app folder and test write access to the web root.
//  - PowerShell read web.config connection strings and app settings through System.Web.Configuration
//    (WebConfigurationManager, WebConfigurationFileMap, VirtualDirectoryMapping), and copied config and logs into the
//    upload folder under .txt names (cfg*.txt, wc*.txt, el*.txt).
//  - With AWS keys, one source cycled through several identities and sent hundreds of List, Get and Describe calls across
//    dozens of services in about half an hour (Boto3/Botocore 1.43.125). Most were denied; a GetSecretValue on a
//    production secret and S3 GetObject, CopyObject and DeleteObject calls succeeded.
// AntiFox is ARTEX's code renamed, so the other ARTEX hunts and the shared behaviors apply too. Do not dismiss a burst because most calls failed.

let Window = 14d;
let WebShellChildren = dynamic(["cmd.exe", "powershell.exe", "pwsh.exe", "where.exe", "whoami.exe", "icacls.exe", "7z.exe", "rar.exe", "tar.exe", "certutil.exe"]);
union isfuzzy=true
    (DeviceProcessEvents
        | where Timestamp > ago(Window)
        | where InitiatingProcessFileName =~ "w3wp.exe" and FileName in~ (WebShellChildren)
        | extend ConfigRead = ProcessCommandLine has_any ("WebConfigurationManager", "WebConfigurationFileMap", "VirtualDirectoryMapping", "ConnectionStrings", "AppSettings")
        | summarize Commands=make_set(substring(ProcessCommandLine, 0, 200), 15), Children=make_set(FileName, 10), ConfigReads=countif(ConfigRead),
            Timestamp=min(Timestamp) by DeviceName, AppPool=InitiatingProcessCommandLine
        | project Timestamp, Device=DeviceName, Signal=iff(ConfigReads > 0, "w3wp shell reading web.config secrets", "w3wp started shell tools"),
            Detail=strcat(tostring(Children), " ", tostring(Commands))),
    (DeviceFileEvents
        | where Timestamp > ago(Window)
        | where InitiatingProcessFileName =~ "w3wp.exe" and ActionType == "FileCreated"
        | where FileName endswith ".aspx" or FileName matches regex @"(?i)^(pwn.*\.aspx|cfg.*\.txt|wc.*\.txt|el.*\.txt)$"
        | project Timestamp, Device=DeviceName, Signal="w3wp wrote an ASPX or a copied config/log file", Detail=FolderPath),
    (AWSCloudTrail
        | where TimeGenerated > ago(Window)
        | where UserAgent has_any ("Boto3/", "Botocore/", "aws-sdk-go", "aws-cli/")
        | where EventName startswith "List" or EventName startswith "Get" or EventName startswith "Describe" or EventName in ("HeadObject", "CopyObject", "DeleteObject")
        | summarize Calls=count(), Denied=countif(ErrorCode in ("AccessDenied", "AccessDeniedException", "UnauthorizedOperation")),
            Services=dcount(EventSource), Identities=dcount(UserIdentityArn),
            Succeeded=make_set_if(EventName, isempty(ErrorCode) and EventName in ("GetSecretValue", "GetObject", "CopyObject", "DeleteObject", "GetParameter"), 10),
            UAs=make_set(UserAgent, 3), Timestamp=min(TimeGenerated) by SourceIpAddress, bin(TimeGenerated, 30m)
        | where Services >= 8 and Calls >= 100
        | extend Known = SourceIpAddress in ("47.79.4.33", "8.208.101.210")
        | project Timestamp, Device=SourceIpAddress,
            Signal=iff(Known, "AWS burst from a reported AntiFox address", "AWS enumeration burst across many services"),
            Detail=strcat(Calls, " calls, ", Denied, " denied, ", Services, " services, ", Identities, " identities, succeeded: ", tostring(Succeeded), " ", tostring(UAs)))
| order by Timestamp desc
