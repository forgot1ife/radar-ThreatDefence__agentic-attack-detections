/*
   Agentic attack detections by ThreatDefence: Guardian
   https://github.com/ThreatDefence/agentic-attack-detections

   Experimental. Built from the Guardian source code (zakirkun/guardian-cli at 51864a81, June 28, 2026).
*/

rule Guardian_Source
{
    meta:
        description = "Guardian AI pentest CLI source (a clone of zakirkun/guardian-cli or the guardian-cli Docker image built from it), or a fork that keeps its strings"
        mitre_att = "T1588.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/zakirkun/guardian-cli"
        confidence = "high"
    strings:
        $ua = "Guardian-CLI/4 (security testing; +authorized engagement)" ascii
        $s1 = "\"X-Title\": \"Guardian AI Pentest\"" ascii
        $s2 = "Report generated by Guardian AI Pentest Tool" ascii
        $s3 = "/tmp/guardian_ffuf_wordlist.txt" ascii
        $s4 = "\"guardian-prowler\"" ascii
        $s5 = "You are the Strategic Planner for Guardian, an enterprise-grade" ascii
        $s6 = "You are the Tool Selector for Guardian, an enterprise-grade" ascii
        $s7 = "GUARDIAN_SLACK_WEBHOOK" ascii
        $s8 = "*Guardian session {memory.session_id}*" ascii
        $s9 = "github.com/zakirkun/guardian-cli" ascii
    condition:
        filesize < 500KB and ($ua or any of ($s1, $s3, $s4, $s8) or 2 of ($s*))
}

rule Guardian_Session_File
{
    meta:
        description = "Guardian session checkpoint (reports/session_<yyyymmdd_HHMMSS>.json): target, every tool command and its output, findings, model decisions, reasoning chain and token costs of one engagement"
        mitre_att = "T1595.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/zakirkun/guardian-cli/blob/51864a81f484e2826dccd2f60fd181a040585962/core/memory.py#L329-L350"
        confidence = "high"
    strings:
        $k1 = "\"session_id\": \"" ascii
        $k2 = "\"completed_actions\": [" ascii
        $k3 = "\"tool_executions\": [" ascii
        $k4 = "\"ai_decisions\": [" ascii
        $k5 = "\"token_ledger\": [" ascii
        $k6 = "\"thinking_chain\": [" ascii
        $k7 = "\"threat_model\": " ascii
        $k8 = "\"attack_surface\": " ascii
        $k9 = "\"token_summary\": {" ascii
    condition:
        uint8(0) == 0x7b and 8 of ($k*)
}

rule Guardian_Report
{
    meta:
        description = "Markdown, HTML or SARIF report written by Guardian (reports/report_<session id>.md, .html or .sarif)"
        mitre_att = "T1595.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/zakirkun/guardian-cli/blob/51864a81f484e2826dccd2f60fd181a040585962/core/reporter_agent.py#L221"
        confidence = "high"
    strings:
        $f1 = "Report generated by Guardian AI Pentest Tool" ascii
        $m1 = "## AI Decision Trace" ascii
        $h1 = "<title>Penetration Test Report - " ascii
        $h2 = "<h2>AI Decision Trace</h2>" ascii
        $r1 = "\"informationUri\": \"https://github.com/zakirkun/guardian-cli\"" ascii
        $r2 = "\"session_id\": \"" ascii
    condition:
        filesize < 50MB and (($f1 and ($m1 or $h1 or $h2)) or ($h1 and $h2) or all of ($r*))
}

rule Guardian_AI_Audit_Log
{
    meta:
        description = "Guardian AI decision audit log (logs/ai_audit.log): one JSON record per model decision, with the agent name, decision and reasoning"
        mitre_att = "T1595.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/zakirkun/guardian-cli/blob/51864a81f484e2826dccd2f60fd181a040585962/utils/logger.py#L108-L131"
        confidence = "medium"
    strings:
        $r = "{\"timestamp\": \"" ascii
        $t = "\", \"type\": \"ai_decision\", \"agent\": \"" ascii
        $a1 = "\"agent\": \"Planner\"" ascii
        $a2 = "\"agent\": \"ToolSelector\"" ascii
        $a3 = "\"agent\": \"Analyst\"" ascii
        $a4 = "\"agent\": \"Reporter\"" ascii
    condition:
        $r at 0 and #t > 1 and 1 of ($a*)
}
