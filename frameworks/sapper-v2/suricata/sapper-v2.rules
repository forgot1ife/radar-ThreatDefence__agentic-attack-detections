# Agentic attack detections by ThreatDefence: sapper-v2
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3817101-3817149. From the sapper-v2 source code (N1nEmAn/sapper-v2 at 7b75e6f1).
# sapper-v2 sends nothing of its own to a target: its agents run stock Kali tools. These rules find its board
# (sapper view --serve, plain HTTP, no login, 127.0.0.1:8765 by default) and its contest-platform client.

# --- The engagement graph board (lib/view_template.html, lib/sapper.py _view_serve) ---
alert http any any -> any any (msg:"TD sapper-v2 engagement graph board page"; flow:established,to_client; http.response_body; content:"<title>sapper |e2 80 94| engagement graph</title>"; fast_pattern; classtype:policy-violation; sid:3817101; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family sapper-v2, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD sapper-v2 live board page with graph poll path"; flow:established,to_client; http.response_body; content:"const POLL_URL = |22|/__sapper_graph__/"; fast_pattern; classtype:policy-violation; sid:3817102; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family sapper-v2, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD sapper-v2 board template graph marker (any title)"; flow:established,to_client; http.response_body; content:"/*__GRAPH_JSON__*/"; fast_pattern; content:"/*__END__*/"; distance:0; classtype:policy-violation; sid:3817103; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family sapper-v2, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD sapper-v2 board graph JSON request"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/__sapper_graph__/"; startswith; fast_pattern; pcre:"/^\/__sapper_graph__\/[0-9a-f]{24}\.json(?:\?|$)/"; classtype:policy-violation; sid:3817104; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family sapper-v2, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD sapper-v2 engagement graph JSON in a response"; flow:established,to_client; http.response_body; content:"|22|open_intents|22|: ["; fast_pattern; content:"|22|done_intents|22|: ["; content:"|22|fact_ids|22|: ["; classtype:policy-violation; sid:3817105; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family sapper-v2, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Contest platform client (lib/arena.py, docker/entrypoint.sh). Any TSecBench contest agent sends the same ---
alert http $HOME_NET any -> any any (msg:"TD TSecBench contest API client (sapper-v2 arena)"; flow:established,to_server; http.header; content:"BENCHMARK_TOKEN|3a|"; nocase; fast_pattern; http.uri; content:"/openapi/v1/challenges"; classtype:policy-violation; sid:3817106; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family sapper-v2, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
