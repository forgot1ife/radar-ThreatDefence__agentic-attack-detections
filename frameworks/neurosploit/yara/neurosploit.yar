/*
   Agentic attack detections by ThreatDefence: NeuroSploit
   https://github.com/ThreatDefence/agentic-attack-detections

   Experimental. Strings from JoasASantos/NeuroSploit at 54d8e860. Tested against the NeuroSploit source tree and the
   other agent code bases in this repository.
*/

rule NeuroSploit_Binary_Or_Source
{
    meta:
        description = "NeuroSploit harness binary or source: its scan header, baseline probe path, web shell manager user agent or finding attribution"
        mitre_att = "T1588.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/JoasASantos/NeuroSploit"
        confidence = "high"
    strings:
        $header = "X-NeuroSploit-Scan" ascii
        $probe = "nrsplt_baseline_404_check_9x7" ascii
        $shell_ua = "NeuroSploit-WebShell/1.0" ascii
        $attribution = "Identified and validated by NeuroSploit" ascii
    condition:
        filesize < 200MB and any of them
}

rule NeuroSploit_Generated_WebShell
{
    meta:
        description = "Web shell generated by the NeuroSploit C2 and web shell manager (PHP, ASPX, ASP or JSP), found on a web server"
        mitre_att = "T1505.003"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/JoasASantos/NeuroSploit"
        confidence = "high"
    strings:
        $banner = "NeuroSploit WebShell" ascii
        $php = "passthru($c)" ascii
        $aspx = "\"cmd.exe\", \"/c \" + c" ascii
        $asp = "sh.Exec(\"cmd.exe /c \" & c)" ascii
        $jsp = "new String[]{\"/bin/sh\",\"-c\",c}" ascii
    condition:
        filesize < 64KB and $banner and any of ($php, $aspx, $asp, $jsp)
}

rule NeuroSploit_C2_Beacon
{
    meta:
        description = "NeuroSploit C2 beacon script (bash, Python, PowerShell or PHP) or its curl one-liner"
        mitre_att = "T1071.001,T1059.004,T1059.001"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/JoasASantos/NeuroSploit"
        confidence = "high"
    strings:
        $banner = "NeuroSploit C2 beacon (HTTP" ascii
        $token = "X-Implant-Token" ascii
        $path = "/api/beacon" ascii
    condition:
        filesize < 256KB and (($banner and ($token or $path)) or ($token and $path))
}

rule NeuroSploit_Run_Output
{
    meta:
        description = "NeuroSploit findings, report or SARIF output: the attribution line every finding carries and the provenance keys"
        mitre_att = "T1588.002"
        author = "ThreatDefence"
        date = "2026-11-26"
        reference = "https://github.com/JoasASantos/NeuroSploit"
        confidence = "medium"
    strings:
        $attribution = "Identified and validated by NeuroSploit (multi-model adversarial validation)" ascii
        $prov = "\"_provenance\": \"NEUROSPLOIT-" ascii
    condition:
        filesize < 100MB and any of them
}
