# Agentic attack detections by ThreatDefence: NeuroSploit
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3817201-3817249. HTTP rules need cleartext HTTP or decrypted traffic.
# Strings from JoasASantos/NeuroSploit at 54d8e860. The web console (4173), the out-of-band listener and the C2 listener
# are plain HTTP, so their rules work without decryption.

# --- Requests that reach your targets ---
alert http any any -> $HTTP_SERVERS any (msg:"TD NeuroSploit scanner user agent"; flow:established,to_server; http.user_agent; content:"NeuroSploit/"; startswith; fast_pattern; classtype:web-application-attack; sid:3817201; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NeuroSploit, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD NeuroSploit X-NeuroSploit-Scan attribution header"; flow:established,to_server; http.header_names; content:"|0d 0a|x-neurosploit-scan|0d 0a|"; nocase; fast_pattern; classtype:web-application-attack; sid:3817202; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NeuroSploit, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD NeuroSploit soft-404 baseline probe path"; flow:established,to_server; http.uri; content:"/nrsplt_baseline_404_check_9x7"; fast_pattern; classtype:web-application-attack; sid:3817203; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NeuroSploit, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD NeuroSploit provenance sigil canary in URI"; flow:established,to_server; http.uri; content:"NEUROSPLOIT"; fast_pattern; pcre:"/NEUROSPLOIT[a-z0-9]{12,}/"; classtype:web-application-attack; sid:3817204; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family NeuroSploit, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD NeuroSploit provenance sigil canary in request body"; flow:established,to_server; http.request_body; content:"NEUROSPLOIT"; fast_pattern; pcre:"/NEUROSPLOIT[a-z0-9]{12,}/"; classtype:web-application-attack; sid:3817205; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family NeuroSploit, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD NeuroSploit sign-up test account nrsplt_"; flow:established,to_server; http.request_body; content:"nrsplt_"; fast_pattern; classtype:web-application-attack; sid:3817206; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family NeuroSploit, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD NeuroSploit open redirect candidate host neurosploit.example"; flow:established,to_server; http.uri; content:"neurosploit.example"; nocase; fast_pattern; classtype:web-application-attack; sid:3817207; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NeuroSploit, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD NeuroSploit SSRF candidate oob.invalid (no out-of-band domain set)"; flow:established,to_server; http.uri.raw; content:"%3A%2F%2Foob.invalid"; nocase; fast_pattern; classtype:web-application-attack; sid:3817208; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family NeuroSploit, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)

# --- Your servers calling the operator's out-of-band listener (a payload ran) ---
# Tokens always start with neurosploit; neurosploitai.github.io is the project's documentation site and is left out.
alert dns $HOME_NET any -> any any (msg:"TD NeuroSploit out-of-band token lookup"; dns.query; content:"neurosploit"; startswith; nocase; fast_pattern; pcre:"/^neurosploit(?!ai\.)[a-z0-9]{4,}\./i"; threshold:type limit, track by_src, count 1, seconds 3600; classtype:web-application-attack; sid:3817209; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NeuroSploit, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD NeuroSploit out-of-band HTTP callback host"; flow:established,to_server; http.host; content:"neurosploit"; startswith; fast_pattern; pcre:"/^neurosploit(?!ai\.)[a-z0-9]{4,}\./"; classtype:web-application-attack; sid:3817210; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NeuroSploit, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- The web shell manager and its shells ---
alert http any any -> $HTTP_SERVERS any (msg:"TD NeuroSploit web shell manager user agent"; flow:established,to_server; http.user_agent; content:"NeuroSploit-WebShell/"; fast_pattern; classtype:web-application-attack; sid:3817211; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NeuroSploit, mitre_tactic_id TA0003, mitre_tactic_name Persistence, mitre_technique_id T1505.003, mitre_technique_name Web_Shell;)
alert http any any -> $HTTP_SERVERS any (msg:"TD NeuroSploit web shell default password in request body"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"pass=ns_pass&cmd="; fast_pattern; classtype:web-application-attack; sid:3817212; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family NeuroSploit, mitre_tactic_id TA0003, mitre_tactic_name Persistence, mitre_technique_id T1505.003, mitre_technique_name Web_Shell;)
alert http any any -> $HTTP_SERVERS any (msg:"TD NeuroSploit web shell default password in URI"; flow:established,to_server; http.uri.raw; content:"pass=ns_pass&cmd="; fast_pattern; classtype:web-application-attack; sid:3817213; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family NeuroSploit, mitre_tactic_id TA0003, mitre_tactic_name Persistence, mitre_technique_id T1505.003, mitre_technique_name Web_Shell;)
alert http any any -> $HTTP_SERVERS any (msg:"TD NeuroSploit generated web shell uploaded"; flow:established,to_server; http.request_body; content:"NeuroSploit WebShell"; fast_pattern; classtype:web-application-attack; sid:3817221; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NeuroSploit, mitre_tactic_id TA0003, mitre_tactic_name Persistence, mitre_technique_id T1505.003, mitre_technique_name Web_Shell;)

# --- C2 beacons on a compromised host ---
alert http $HOME_NET any -> any any (msg:"TD NeuroSploit C2 beacon check-in"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/beacon"; startswith; fast_pattern; http.header_names; content:"|0d 0a|X-Implant-Token|0d 0a|"; nocase; classtype:trojan-activity; sid:3817214; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NeuroSploit, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> $HOME_NET any (msg:"TD NeuroSploit C2 listener task answer to the bash beacon"; flow:established,to_client; http.response_body; content:"SID=s_"; startswith; fast_pattern; content:"|0a|SLEEP="; content:"|0a|JITTER="; classtype:trojan-activity; sid:3817215; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NeuroSploit, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> $HOME_NET any (msg:"TD NeuroSploit C2 listener refused an implant token"; flow:established,to_client; http.stat_code; content:"401"; http.response_body; content:"invalid implant token"; fast_pattern; classtype:trojan-activity; sid:3817216; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family NeuroSploit, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> $HOME_NET any (msg:"TD NeuroSploit C2 beacon script downloaded"; flow:established,to_client; http.response_body; content:"NeuroSploit C2 beacon (HTTP"; fast_pattern; classtype:trojan-activity; sid:3817222; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family NeuroSploit, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- An exposed NeuroSploit web console (4173, no authentication) ---
alert http any any -> any any (msg:"TD NeuroSploit console page"; flow:established,to_client; http.response_body; content:"<title>NeuroSploit"; fast_pattern; classtype:policy-violation; sid:3817217; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family NeuroSploit, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD NeuroSploit console proxy option (survives a renamed title)"; flow:established,to_client; http.response_body; content:"NeuroSploit Interceptor (record + passive discovery)"; fast_pattern; classtype:policy-violation; sid:3817218; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family NeuroSploit, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- The operator's host: integrations and log shipping (mostly TLS; needs decryption) ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD NeuroSploit integration user agent"; flow:established,to_server; http.user_agent; content:"NeuroSploit"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3817219; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family NeuroSploit, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD NeuroSploit log shipping user agent"; flow:established,to_server; http.user_agent; content:"neurosploit-logship/"; startswith; fast_pattern; classtype:policy-violation; sid:3817220; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family NeuroSploit, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
