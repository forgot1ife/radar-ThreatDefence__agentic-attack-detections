# Agentic attack detections by ThreatDefence: LazyOwn
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3818101-3818149. The DNS rule works on any traffic; the HTTP rules match cleartext HTTP.
# The LazyOwn C2 serves HTTPS when cert.pem and key.pem exist next to lazyc2.py (gen_cert.sh), so on most installs the
# HTTP rules need TLS decryption or a sensor behind the operator's redirector.
# Built from grisuno/LazyOwn at f4e54de9 (November 25, 2026). Beacon behaviour is taken from the C2 server's handlers and
# the configuration it serves; implant source was not reviewed.

# --- The C2 web UI and operator API (lazyc2.py, Flask on werkzeug, port c2_port, default 4444) ---
alert http any any -> any any (msg:"TD LazyOwn C2 web UI Basic auth challenge"; flow:established,to_client; http.stat_code; content:"401"; http.header; content:"Basic realm=|22|Login Required|22|"; http.response_body; content:"Invalid credentials. Please provide valid username and password."; startswith; fast_pattern; classtype:policy-violation; sid:3818101; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD LazyOwn C2 web UI Content-Security-Policy header"; flow:established,to_client; http.header; content:"img-src 'self' data: https://upload.wikimedia.org|3b| style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com|3b|"; fast_pattern; content:"https://unpkg.com https://cdn.jsdelivr.net|3b| script-src-elem"; classtype:policy-violation; sid:3818102; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD LazyOwn C2 dashboard or login page"; flow:established,to_client; http.response_body; content:"<title>LazyOwn Command and Control Center</title>"; fast_pattern; classtype:policy-violation; sid:3818103; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD LazyOwn C2 public health answer"; flow:established,to_client; http.response_body; content:"{|22|components|22 3a 7b 22|beacons|22 3a|"; startswith; fast_pattern; content:"|22|uptime_seconds|22 3a|"; classtype:policy-violation; sid:3818104; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD LazyOwn C2 operator API: connected beacon list"; flow:established,to_server; http.uri; content:"/get_connected_clients"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3818105; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
# The MCP server (skills/lazyown_mcp.py) posts json.dumps({"client_id": ..., "command": ...}) with Python-urllib.
alert http any any -> any any (msg:"TD LazyOwn C2 operator API: command queued for a beacon"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/issue_command"; startswith; endswith; fast_pattern; http.request_body; content:"client_id"; content:"command"; classtype:policy-violation; sid:3818106; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Decoy page served to addresses outside the operator allowlist (on /login and on every 404), which asks the
# --- visitor's browser for camera and microphone and posts what it gets to <page URL>capture and <page URL>audio ---
alert http any any -> any any (msg:"TD LazyOwn C2 decoy page with camera and microphone capture"; flow:established,to_client; http.response_body; content:"<title>Live View Page -  564 plot listing Template</title>"; content:"fetch(urlCompleta + 'capture'"; fast_pattern; classtype:policy-violation; sid:3818107; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family LazyOwn, mitre_tactic_id TA0009, mitre_tactic_name Collection, mitre_technique_id T1125, mitre_technique_name Video_Capture;)
alert http any any -> any any (msg:"TD LazyOwn C2 decoy page camera frame upload"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"capture"; endswith; http.request_body; content:"{|22|image|22 3a 22|data:image/png|3b|base64,"; startswith; fast_pattern; classtype:policy-violation; sid:3818108; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family LazyOwn, mitre_tactic_id TA0009, mitre_tactic_name Collection, mitre_technique_id T1125, mitre_technique_name Video_Capture;)
alert http any any -> any any (msg:"TD LazyOwn C2 decoy page microphone recording upload"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"audio"; endswith; http.request_body; content:"name=|22|audio|22 3b| filename=|22|audio_"; fast_pattern; content:".webm|22|"; classtype:policy-violation; sid:3818109; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family LazyOwn, mitre_tactic_id TA0009, mitre_tactic_name Collection, mitre_technique_id T1123, mitre_technique_name Audio_Capture;)

# --- Beacon traffic as the C2 handlers see it. The malleable route is c2_malleable_route in payload.json,
# --- /gmail/v1/users/ in the shipped example; /command/, /api/poll/ and /report/ are always served as well ---
alert http any any -> any any (msg:"TD LazyOwn beacon poll on the default Gmail-style route"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/gmail/v1/users/"; startswith; fast_pattern; pcre:"/^\/gmail\/v1\/users\/[A-Za-z0-9_.-]+$/"; http.host; content:!"googleapis.com"; content:!"google.com"; flowbits:set,lazyown.gmail_poll; classtype:trojan-activity; sid:3818110; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1001.003, mitre_technique_name Protocol_or_Service_Impersonation;)
alert http any any -> any any (msg:"TD LazyOwn beacon result post on the default Gmail-style route"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/gmail/v1/users/"; startswith; fast_pattern; pcre:"/^\/gmail\/v1\/users\/(?:[A-Za-z0-9_.-]+|report\/)$/"; http.host; content:!"googleapis.com"; content:!"google.com"; classtype:trojan-activity; sid:3818111; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1001.003, mitre_technique_name Protocol_or_Service_Impersonation;)
alert http any any -> any any (msg:"TD LazyOwn beacon staging, BOF or file download on the default Gmail-style route"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/gmail/v1/users/"; startswith; fast_pattern; pcre:"/^\/gmail\/v1\/users\/(?:stage\/(?:beacon|config)$|bof\/|download\/)/"; http.host; content:!"googleapis.com"; content:!"google.com"; classtype:trojan-activity; sid:3818112; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)
alert http any any -> any any (msg:"TD LazyOwn C2 empty command answer to a Gmail-style route poll"; flow:established,to_client; flowbits:isset,lazyown.gmail_poll; http.content_type; content:"application/octet-stream"; fast_pattern; http.response_body; bsize:24; pcre:"/^[A-Za-z0-9+\/]{22}==$/"; classtype:trojan-activity; sid:3818113; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1573.001, mitre_technique_name Symmetric_Cryptography;)
alert http any any -> any any (msg:"TD LazyOwn C2 accepted a beacon report"; flow:established,to_client; http.response_body; content:"{|22|Platform|22 3a 22|"; startswith; fast_pattern; content:"|22|status|22 3a 22|success|22 7d|"; classtype:trojan-activity; sid:3818114; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD LazyOwn C2 BOF object not found answer"; flow:established,to_client; http.response_body; content:"BOF_NOT_FOUND|0d 0a|"; startswith; endswith; fast_pattern; classtype:trojan-activity; sid:3818115; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)
alert http any any -> any any (msg:"TD LazyOwn C2 staging channel refused or empty"; flow:established,to_client; http.response_body; content:"STAGE_"; startswith; fast_pattern; pcre:"/^STAGE_(?:FORBIDDEN|UNAVAILABLE)\r\n$/"; classtype:trojan-activity; sid:3818116; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)
alert http any any -> any any (msg:"TD LazyOwn diskless stager request with bearer token"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/stage/"; fast_pattern; pcre:"/\/stage\/(?:beacon|config)$/"; http.header; content:"Authorization|3a 20|Bearer "; nocase; classtype:trojan-activity; sid:3818117; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)

# --- User agents in the configuration LazyOwn ships for its beacons ---
alert http any any -> any any (msg:"TD LazyOwn LAzyOwnRedTeam user agent"; flow:established,to_server; http.user_agent; content:"LAzyOwnRedTeam"; fast_pattern; classtype:trojan-activity; sid:3818120; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD LazyOwn BlackSandBeacon config user agent (Chrome and Firefox tokens together)"; flow:established,to_server; http.user_agent; content:"Mozilla/5.0 (Windows NT 10.0|3b| Win64|3b| x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Firefox/120.0"; startswith; endswith; fast_pattern; classtype:trojan-activity; sid:3818121; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
# user_agent_win / user_agent_lin of the shipped payload.json: an old Chrome 58 string cut to "Safari/537.3". Widely
# copied into scrapers, so this rule only looks at the default C2 port.
alert http any any -> any 4444 (msg:"TD LazyOwn default beacon user agent on the default C2 port"; flow:established,to_server; http.user_agent; content:"AppleWebKit/537.36 (KHTML, like Gecko) Chrome/58.0.3029.110 Safari/537.3"; endswith; fast_pattern; classtype:trojan-activity; sid:3818122; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- DNS channel of the C2 (dnslib server on UDP 53 of lhost, on by default) ---
alert dns any any -> any any (msg:"TD LazyOwn DNS C2 query (c2.lazyown.org)"; dns.query; dotprefix; content:".c2.lazyown.org"; nocase; endswith; fast_pattern; classtype:trojan-activity; sid:3818125; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family LazyOwn, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)

# --- Requests from the host that runs LazyOwn (HTTPS: need TLS inspection) ---
alert http any any -> any any (msg:"TD LazyOwn exploit search user agent (exploitalert.com)"; flow:established,to_server; http.user_agent; content:"LazyOwn/1.0"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3818130; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family LazyOwn, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.005, mitre_technique_name Exploits;)
alert http any any -> any any (msg:"TD LazyOwn dependency confusion check user agent"; flow:established,to_server; http.user_agent; content:"lazyown-depconfuse/"; startswith; fast_pattern; classtype:policy-violation; sid:3818131; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family LazyOwn, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1195.001, mitre_technique_name Compromise_Software_Dependencies_and_Development_Tools;)
