alert http any any -> $HTTP_SERVERS any (msg:"TD Vigilo grey-box open redirect probe host vigilo-probe .invalid"; flow:established,to_server; http.uri; content:"vigilo-probe-"; fast_pattern; pcre:"/vigilo-probe-[0-9a-f]{8}\.invalid/"; classtype:web-application-attack; sid:3817406; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Vigilo, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
