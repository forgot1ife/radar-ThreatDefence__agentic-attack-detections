alert http any any -> $HTTP_SERVERS any (msg:"TD Vigilo grey-box soft-404 baseline path /vgl-"; flow:established,to_server; http.uri; content:"/vgl-"; startswith; fast_pattern; pcre:"/^\/vgl-[0-9a-f]{8}$/"; classtype:attempted-recon; sid:3817408; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Vigilo, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
