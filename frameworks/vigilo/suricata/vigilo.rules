# Agentic attack detections by ThreatDefence: Vigilo
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3817401-3817449. HTTP rules need cleartext HTTP or decrypted traffic.
# Strings from certeu/vigilo at 82c2d353 (v1.0.0). Vigilo is a CERT-EU tool for assessing your own applications: a match
# means a Vigilo assessment, so check that it was agreed.

# --- Grey-box requests that reach your targets (every request goes through src/greybox_web/netguard.py) ---
alert http any any -> $HTTP_SERVERS any (msg:"TD Vigilo grey-box assessment user agent"; flow:established,to_server; http.user_agent; content:"Vigilo-Greybox/"; startswith; fast_pattern; classtype:web-application-attack; sid:3817401; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Vigilo, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Vigilo white-box preflight user agent"; flow:established,to_server; http.user_agent; content:"Vigilo-Preflight/"; startswith; fast_pattern; classtype:attempted-recon; sid:3817402; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Vigilo, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Vigilo grey-box header echo probe X-Note-Name"; flow:established,to_server; http.header; content:"X-Note-Name|3a 20|vigilo"; nocase; fast_pattern; content:"<e>|0d 0a|"; distance:8; within:5; classtype:web-application-attack; sid:3817403; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Vigilo, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Vigilo grey-box reflection canary in URI"; flow:established,to_server; http.uri.raw; content:"%22%27%3C%3Eb"; fast_pattern; pcre:"/vgl[0-9a-f]{8}%22%27%3C%3Eb/"; classtype:web-application-attack; sid:3817404; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Vigilo, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
