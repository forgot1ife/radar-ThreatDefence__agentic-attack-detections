# --- Grey-box network mode (src/greybox_web/netcap.py) ---
alert tcp any any -> $HOME_NET any (msg:"TD Vigilo grey-box network mode SMTP greeting EHLO vigilo.invalid"; flow:established,to_server; content:"EHLO vigilo.invalid|0d 0a|"; nocase; fast_pattern; classtype:attempted-recon; sid:3817416; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Vigilo, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1046, mitre_technique_name Network_Service_Discovery;)

# --- An exposed Vigilo instance (login required, no default account) ---
alert http any any -> any any (msg:"TD Vigilo web UI page"; flow:established,to_client; http.response_body; content:"<title>Vigilo</title>"; fast_pattern; http.header; content:"frame-ancestors 'none'"; classtype:policy-violation; sid:3817417; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Vigilo, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert http any any -> any any (msg:"TD Vigilo platform API response headers"; flow:established,to_client; http.header; content:"default-src 'none'|3b| frame-ancestors 'none'|3b| base-uri 'none'|3b| form-action 'none'"; fast_pattern; http.server; content:"uvicorn"; classtype:policy-violation; sid:3817418; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Vigilo, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
