# Agentic attack detections by ThreatDefence: Cyber-AutoAgent
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3815001-3815499. HTTP rules need cleartext HTTP or decrypted traffic.
# The bundled Langfuse (3000) is plain HTTP, so the Langfuse rules work without decryption.

# --- Requests that reach your targets ---
alert http any any -> $HTTP_SERVERS any (msg:"TD Cyber-AutoAgent dalfox blind XSS callback in request"; flow:established,to_server; http.uri; content:"dalfox-xss-test.com"; nocase; fast_pattern; classtype:web-application-attack; sid:3815001; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Cyber-AutoAgent, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert dns $HOME_NET any -> any any (msg:"TD Cyber-AutoAgent dalfox blind XSS callback lookup (payload ran)"; dns.query; dotprefix; content:".dalfox-xss-test.com"; nocase; endswith; fast_pattern; classtype:web-application-attack; sid:3815002; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Cyber-AutoAgent, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)

# --- The operator's host talking to its Langfuse (seen when LANGFUSE_HOST is another machine) ---
alert http any any -> any any (msg:"TD Cyber-AutoAgent default Langfuse API key (cyber-public:cyber-secret)"; flow:established,to_server; http.header; content:"Basic Y3liZXItcHVibGljOmN5YmVyLXNlY3JldA=="; fast_pattern; classtype:policy-violation; sid:3815010; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Cyber-AutoAgent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1078.001, mitre_technique_name Default_Accounts;)
alert http any any -> any any (msg:"TD Cyber-AutoAgent prompt fetch from Langfuse (cyber/system, cyber/report)"; flow:established,to_server; http.uri; content:"/api/public/v2/prompts/cyber/"; startswith; fast_pattern; pcre:"/^\/api\/public\/v2\/prompts\/cyber\/(?:system|report)\//"; classtype:policy-violation; sid:3815011; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Cyber-AutoAgent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Cyber-AutoAgent trace export to Langfuse"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/public/otel/v1/traces"; startswith; http.request_body; content:"cyber-autoagent"; nocase; fast_pattern; classtype:policy-violation; sid:3815012; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Cyber-AutoAgent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- An exposed Cyber-AutoAgent Langfuse (0.0.0.0:3000) ---
alert http any any -> any any (msg:"TD Cyber-AutoAgent Langfuse default admin login (admin@cyber-autoagent.com)"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"cyber-autoagent.com"; nocase; fast_pattern; classtype:policy-violation; sid:3815013; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Cyber-AutoAgent, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1078.001, mitre_technique_name Default_Accounts;)
alert http any any -> any any (msg:"TD Cyber-AutoAgent Langfuse project page (cyber-project-id)"; flow:established,to_server; http.uri; content:"/project/cyber-project-id"; fast_pattern; classtype:policy-violation; sid:3815014; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Cyber-AutoAgent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Cyber-AutoAgent Langfuse answer naming its seeded project"; flow:established,to_client; http.response_body; content:"cyber-project-id"; fast_pattern; classtype:policy-violation; sid:3815015; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Cyber-AutoAgent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
