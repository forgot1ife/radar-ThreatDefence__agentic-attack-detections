# Agentic attack detections by ThreatDefence: Custom AI Agent (six2dez/burp-ai-agent, formerly Burp AI Agent)
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3818701-3818749. HTTP rules need cleartext HTTP or decrypted traffic.
# The extension sends target traffic through Burp, so it has no user agent of its own: these rules key on the fixed
# markers in its active scanners' payload table (src/main/kotlin/com/six2dez/burp/aiagent/scanner/PayloadGenerator.kt).

# --- Active AI scanner payloads reaching your targets ---
alert http any any -> $HTTP_SERVERS any (msg:"TD Burp AI Agent XSS payload marker in URI (XSS-BURP-AI)"; flow:established,to_server; http.uri; content:"XSS-BURP-AI"; fast_pattern; classtype:web-application-attack; sid:3818701; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Burp-AI-Agent, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> $HTTP_SERVERS any (msg:"TD Burp AI Agent XSS payload marker in request body (XSS-BURP-AI)"; flow:established,to_server; http.request_body; content:"XSS-BURP-AI"; fast_pattern; classtype:web-application-attack; sid:3818702; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Burp-AI-Agent, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
