alert http any any -> $HTTP_SERVERS any (msg:"TD Burp AI Agent XSS payload marker in a cookie (XSS-BURP-AI)"; flow:established,to_server; http.cookie; content:"XSS-BURP-AI"; fast_pattern; classtype:web-application-attack; sid:3818704; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Burp-AI-Agent, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
