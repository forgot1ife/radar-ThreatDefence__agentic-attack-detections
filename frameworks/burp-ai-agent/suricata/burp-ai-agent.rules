alert http any any -> $HTTP_SERVERS any (msg:"TD Burp AI Agent SSTI arithmetic probe in URI (1337*73, 31337*3)"; flow:established,to_server; http.uri; content:"1337*"; fast_pattern; pcre:"/(?:31337\*3|1337\*73)(?:\}|%7D|[\s+]?%>|(?:\+|%20)?%25%3E)/i"; classtype:web-application-attack; sid:3818711; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Burp-AI-Agent, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
