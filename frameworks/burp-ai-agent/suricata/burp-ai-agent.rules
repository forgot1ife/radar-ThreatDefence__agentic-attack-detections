# --- One of your servers looking up the scanner's test domains (it followed a redirect, SSRF or Host payload) ---
alert dns $HOME_NET any -> any any (msg:"TD Burp AI Agent test domain lookup (evil-burp-ai)"; dns.query; content:"evil-burp-ai"; nocase; fast_pattern; classtype:web-application-attack; sid:3818710; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Burp-AI-Agent, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)

# --- The extension's MCP server and MCP client ---
alert tls any any -> any any (msg:"TD Burp AI Agent MCP server auto-generated certificate (CN=burp-mcp)"; flow:established,to_client; tls.cert_subject; content:"CN=burp-mcp"; endswith; fast_pattern; tls.cert_issuer; content:"CN=burp-mcp"; endswith; classtype:policy-violation; sid:3818713; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Burp-AI-Agent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1587.003, mitre_technique_name Digital_Certificates;)
alert http any any -> any any (msg:"TD Burp AI Agent MCP health answer identity header"; flow:established,to_client; http.header; content:"X-Burp-AI-Agent|3a 20|mcp"; nocase; fast_pattern; classtype:policy-violation; sid:3818714; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Burp-AI-Agent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Burp AI Agent MCP health or shutdown route request"; flow:established,to_server; http.uri; content:"/__mcp/"; startswith; fast_pattern; pcre:"/^\/__mcp\/(?:health|shutdown)(?:[?#]|$)/"; classtype:policy-violation; sid:3818715; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Burp-AI-Agent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Burp AI Agent MCP server name in initialize answer"; flow:established,to_client; http.response_body; content:"|22|serverInfo|22 3a 7b 22|name|22 3a 22|burp-ai-agent|22|"; fast_pattern; classtype:policy-violation; sid:3818716; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Burp-AI-Agent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Burp AI Agent MCP client name sent to an MCP server (burp-ai-agent-ext)"; flow:established,to_server; http.request_body; content:"|22|clientInfo|22 3a 7b 22|name|22 3a 22|burp-ai-agent-ext|22|"; fast_pattern; classtype:policy-violation; sid:3818717; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Burp-AI-Agent, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
