# Agentic attack detections by ThreatDefence: numasec
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3819601-3819649. HTTP rules need cleartext HTTP or decrypted traffic.
# Strings from FrancescoStabile/numasec at 1237a2f (May 8, 2026). The target-side markers come from numasec's own
# AppSec probe, directory fuzzer, service prober and page fetch; what the model runs through bash is covered in behaviors/.

# --- Requests that reach your sites ---
alert http any any -> $HTTP_SERVERS any (msg:"TD numasec AppSec probe user agent"; flow:established,to_server; http.user_agent; content:"numasec-appsec-probe/"; startswith; fast_pattern; classtype:attempted-recon; sid:3819601; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family numasec, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> $HTTP_SERVERS any (msg:"TD numasec XSS probe marker in URI"; flow:established,to_server; http.uri; content:"numasec-xss"; fast_pattern; classtype:web-application-attack; sid:3819602; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family numasec, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> $HTTP_SERVERS any (msg:"TD numasec XSS probe marker in request body"; flow:established,to_server; http.request_body; content:"<script>numasec-xss</script>"; fast_pattern; classtype:web-application-attack; sid:3819603; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family numasec, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> $HTTP_SERVERS any (msg:"TD numasec login probe identity"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"numasec-probe@example.invalid"; fast_pattern; classtype:attempted-recon; sid:3819604; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family numasec, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> $HTTP_SERVERS any (msg:"TD numasec directory fuzzer not-found baseline"; flow:established,to_server; http.uri; content:"/numasec_404_check_"; startswith; fast_pattern; classtype:attempted-recon; sid:3819605; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family numasec, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.003, mitre_technique_name Wordlist_Scanning;)
alert http any any -> $HOME_NET any (msg:"TD numasec service prober request (only Host target)"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/"; startswith; endswith; http.host; content:"target"; startswith; endswith; fast_pattern; http.header_names; content:"|0d 0a|Host|0d 0a 0d 0a|"; startswith; endswith; classtype:attempted-recon; sid:3819606; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family numasec, mitre_tactic_id TA0007, mitre_tactic_name Discovery, mitre_technique_id T1046, mitre_technique_name Network_Service_Discovery;)
alert http any any -> $HTTP_SERVERS any (msg:"TD numasec page fetch fallback user agent"; flow:established,to_server; http.user_agent; content:"numasec"; startswith; endswith; fast_pattern; classtype:attempted-recon; sid:3819607; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family numasec, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1594, mitre_technique_name Search_Victim-Owned_Websites;)

# --- The numasec API server (numasec serve, acp, or a TUI started with --hostname/--mdns) and its clients ---
alert http any any -> any any (msg:"TD numasec API path response"; flow:established,to_client; http.response_body; content:"{|22|home|22 3a 22|"; startswith; content:"numasec|22 2c 22|config|22 3a 22|"; fast_pattern; content:"numasec|22 2c 22|worktree|22 3a 22|"; distance:0; classtype:policy-violation; sid:3819610; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family numasec, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD numasec API agent list response"; flow:established,to_client; http.response_body; content:"|22|description|22 3a 22|Penetration testing specialist. Systematic recon, enumeration, exploitation, and reporting."; fast_pattern; classtype:policy-violation; sid:3819611; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family numasec, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD numasec API client directory header"; flow:established,to_server; http.header_names; content:"|0d 0a|x-numasec-directory|0d 0a|"; nocase; fast_pattern; classtype:policy-violation; sid:3819612; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family numasec, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
