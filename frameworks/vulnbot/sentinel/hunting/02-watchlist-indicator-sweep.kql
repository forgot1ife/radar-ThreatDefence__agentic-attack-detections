// Indicator sweep with the agentic watchlist
// Agentic attack detections by ThreatDefence (VulnBot). Source: https://github.com/ThreatDefence/agentic-attack-detections
// ATT&CK: T1588.002 (Obtain Capabilities: Tool), T1059.004 (Command and Scripting Interpreter: Unix Shell)
// Upload feeds/sentinel-watchlist.csv as a Microsoft Sentinel watchlist with the alias AGENTIC_IOCs and the search key
// "value". A match needs investigation.
// No VulnBot infrastructure has been published, so these rows are fingerprints of the software: its prompts, its
// command lines, its log file name and the shell setup it runs on the Kali host it drives.

let IOC = _GetWatchlist('AGENTIC_IOCs') | where framework has "vulnbot" | project value=tostring(SearchKey), type, confidence, actor, source;
let Strings = toscalar(IOC | where type == "string" and confidence in ("high", "medium") | summarize make_list(value));
let FileNames = toscalar(IOC | where type == "file_name" | summarize make_list(value));
let Paths = toscalar(IOC | where type == "uri_string" | summarize make_list(value));
union isfuzzy=true
    (DeviceProcessEvents | where Timestamp > ago(30d)
        | where ProcessCommandLine has_any (Strings)
        | extend Indicator=Strings | mv-expand Indicator to typeof(string) | where ProcessCommandLine contains Indicator
        | project TimeGenerated=Timestamp, Source="DeviceProcessEvents", Indicator, Detail=strcat(DeviceName, " ", substring(ProcessCommandLine, 0, 200))),
    (DeviceFileEvents | where Timestamp > ago(30d)
        | where FileName in~ (FileNames)
        | project TimeGenerated=Timestamp, Source="DeviceFileEvents", Indicator=FileName, Detail=strcat(DeviceName, " ", FolderPath)),
    (CommonSecurityLog | where TimeGenerated > ago(90d)
        | where RequestURL has_any (Paths)
        | extend Indicator=Paths | mv-expand Indicator to typeof(string) | where RequestURL contains Indicator
        | project TimeGenerated, Source="CommonSecurityLog", Indicator, Detail=strcat(SourceIP, " -> ", RequestURL)),
    (W3CIISLog | where TimeGenerated > ago(90d)
        | where csUriStem has_any (Paths)
        | extend Indicator=Paths | mv-expand Indicator to typeof(string) | where csUriStem contains Indicator
        | project TimeGenerated, Source="W3CIISLog", Indicator, Detail=strcat(cIP, " ", csUriStem))
| join kind=leftouter (IOC) on $left.Indicator == $right.value
| summarize Events=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), Details=make_set(Detail, 10)
    by Source, Indicator, actor, confidence
| order by LastSeen desc
