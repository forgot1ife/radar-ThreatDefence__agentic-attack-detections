// Indicator sweep with the agentic watchlist
// Agentic attack detections by ThreatDefence (RAPTOR). Source: https://github.com/ThreatDefence/agentic-attack-detections
// ATT&CK: T1595.002 (Active Scanning: Vulnerability Scanning), T1588.002 (Obtain Capabilities: Tool)
// Upload feeds/sentinel-watchlist.csv as a Microsoft Sentinel watchlist with the alias AGENTIC_IOCs and the search key
// "value". A match needs investigation. RAPTOR has no infrastructure of its own, so its rows are user agents, probe
// strings, URI strings, file names and paths; the sweep looks for the user agents in web and proxy logs, the URI
// strings in web logs, and the strings and paths on hosts.

let IOC = _GetWatchlist('AGENTIC_IOCs') | where framework has "raptor" | project value=tostring(SearchKey), type, confidence, actor, source;
let UAs = toscalar(IOC | where type == "user_agent" and confidence in ("high", "medium") | summarize make_list(value));
let Uris = toscalar(IOC | where type == "uri_string" and confidence in ("high", "medium") | summarize make_list(value));
let Strings = toscalar(IOC | where type in ("string", "file_name", "file_path") and confidence in ("high", "medium") | summarize make_list(value));
union isfuzzy=true
    (CommonSecurityLog | where TimeGenerated > ago(90d)
        | where RequestClientApplication has_any (UAs) or RequestURL has_any (Uris)
        | project TimeGenerated, Source="CommonSecurityLog", Indicator=RequestClientApplication, Detail=strcat(SourceIP, " ", RequestURL)),
    (W3CIISLog | where TimeGenerated > ago(90d)
        | extend UA=replace_string(csUserAgent, "+", " ")
        | where UA has_any (UAs) or csUriStem has_any (Uris) or csUriQuery has_any (Uris)
        | project TimeGenerated, Source="W3CIISLog", Indicator=UA, Detail=strcat(cIP, " ", csUriStem, "?", csUriQuery)),
    (DeviceProcessEvents | where Timestamp > ago(30d)
        | where ProcessCommandLine has_any (Strings)
        | project TimeGenerated=Timestamp, Source="DeviceProcessEvents", Indicator=substring(ProcessCommandLine, 0, 200),
            Detail=strcat(DeviceName, " ", InitiatingProcessFileName)),
    (DeviceFileEvents | where Timestamp > ago(30d)
        | where FolderPath has_any (Strings)
        | project TimeGenerated=Timestamp, Source="DeviceFileEvents", Indicator=FolderPath, Detail=strcat(DeviceName, " ", FolderPath))
| summarize Events=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), Details=make_set(Detail, 10)
    by Source, Indicator
| order by LastSeen desc
