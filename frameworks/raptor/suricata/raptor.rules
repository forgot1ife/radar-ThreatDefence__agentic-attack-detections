# --- RAPTOR's own clients leaving the operator's host (package registries, GitHub, OSV, NVD, OCI registries) ---
alert http any any -> any any (msg:"TD RAPTOR HTTP client user agent (core or SCA)"; flow:established,to_server; http.user_agent; content:"(+https://github.com/gadievron/raptor)"; fast_pattern; pcre:"/^raptor(?:-sca)?\/[0-9.]+ \(\+https:\/\/github\.com\/gadievron\/raptor\)$/"; classtype:policy-violation; sid:3819930; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family RAPTOR, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert http any any -> any any (msg:"TD RAPTOR helper client user agent"; flow:established,to_server; http.user_agent; content:"raptor-"; startswith; fast_pattern; pcre:"/^raptor-(?:sca|nvd\/[0-9.]+|env-verify\/[0-9.]+|container-evidence\/[0-9]+|uv-provenance\/[0-9]+|cvefix-envs\/[0-9.]+)$/"; classtype:policy-violation; sid:3819931; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family RAPTOR, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
alert http any any -> any any (msg:"TD RAPTOR cve-diff or cve-env client user agent"; flow:established,to_server; http.user_agent; content:"cve-"; startswith; fast_pattern; pcre:"/^cve-(?:diff(?:-agent|-gitlab|-health|-cross-check|-consensus)?|env(?:-doctor|-source-build)?)\/0\.1(?: \((?:\+https:\/\/github\.com\/cve-diff|agentic CVE env builder)\))?$/"; classtype:policy-violation; sid:3819932; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family RAPTOR, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
