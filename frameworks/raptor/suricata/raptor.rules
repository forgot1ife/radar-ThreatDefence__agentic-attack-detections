# Agentic attack detections by ThreatDefence: RAPTOR
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3819901-3819949. HTTP rules need cleartext HTTP or decrypted traffic.
# RAPTOR has no web console. The target-side rules match its web scanner (python3 raptor.py web, /web); the rest match
# the user agents of its own HTTP clients leaving the operator's host.

# --- Web scanner requests to your sites (packages/web) ---
alert http any any -> any any (msg:"TD RAPTOR web scanner user agent"; flow:established,to_server; http.user_agent; content:"RAPTOR Security Scanner"; startswith; fast_pattern; classtype:web-application-attack; sid:3819901; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family RAPTOR, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
