// Indicator sweep with the agentic watchlist
// Agentic attack detections by ThreatDefence (0security). Source: https://github.com/ThreatDefence/agentic-attack-detections
// ATT&CK: T1595.002 (Active Scanning: Vulnerability Scanning), T1588.002 (Obtain Capabilities: Tool)
// Upload feeds/sentinel-watchlist.csv as a Microsoft Sentinel watchlist with the alias AGENTIC_IOCs and the search key
// "value". A match needs investigation. 0security publishes no attack infrastructure, so its rows are its user agents,
// its cloud host, its file and binary names, its Docker image, the probe and playbook canaries and the console strings.

let IOC = _GetWatchlist('AGENTIC_IOCs') | where framework has "zerosecurity" | project value=tostring(SearchKey), type, confidence, actor, source;
let IPList = toscalar(IOC | where type in ("ipv4", "ipv6") | summarize make_list(value));
let UAs = toscalar(IOC | where type == "user_agent" | summarize make_list(value));
let Domains = toscalar(IOC | where type == "domain" | summarize make_list(value));
let Names = toscalar(IOC | where type == "file_name" and confidence in ("high", "medium") | summarize make_list(value));
let Strings = toscalar(IOC | where type == "string" and confidence in ("high", "medium") | summarize make_list(value));
union isfuzzy=true
    (CommonSecurityLog | where TimeGenerated > ago(90d)
        | where SourceIP in (IPList) or DestinationIP in (IPList) or RequestClientApplication in (UAs) or DestinationHostName has_any (Domains)
            or RequestURL has_any (Strings)
        | project TimeGenerated, Source="CommonSecurityLog", Detail=RequestURL,
            Indicator=case(SourceIP in (IPList), SourceIP, DestinationIP in (IPList), DestinationIP, RequestClientApplication in (UAs), RequestClientApplication,
                DestinationHostName has_any (Domains), DestinationHostName, RequestURL)),
    (DeviceNetworkEvents | where Timestamp > ago(30d)
        | where RemoteIP in (IPList) or RemoteUrl has_any (Domains)
        | project TimeGenerated=Timestamp, Source="DeviceNetworkEvents", Indicator=iff(RemoteIP in (IPList), RemoteIP, RemoteUrl),
            Detail=strcat(DeviceName, " ", InitiatingProcessFileName)),
    (DeviceProcessEvents | where Timestamp > ago(30d)
        | where FileName in~ (Names)
        | project TimeGenerated=Timestamp, Source="DeviceProcessEvents", Indicator=FileName, Detail=strcat(DeviceName, " ", FolderPath)),
    (DeviceFileEvents | where Timestamp > ago(30d)
        | where FileName in~ (Names)
        | project TimeGenerated=Timestamp, Source="DeviceFileEvents", Indicator=FileName, Detail=strcat(DeviceName, " ", FolderPath)),
    (DnsEvents | where TimeGenerated > ago(90d)
        | where Name has_any (Domains)
        | project TimeGenerated, Source="DnsEvents", Indicator=Name, Detail=ClientIP)
| join kind=leftouter (IOC) on $left.Indicator == $right.value
| summarize Events=count(), FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated), Details=make_set(Detail, 10)
    by Source, Indicator, actor, confidence
| order by LastSeen desc
