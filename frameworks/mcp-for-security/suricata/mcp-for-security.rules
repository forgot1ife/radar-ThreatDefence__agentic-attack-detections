# Agentic attack detections by ThreatDefence: MCP for Security
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3813261-3813275. Strings from cyproxio/mcp-for-security at 51dd537f.
# The wrappers talk MCP over stdio and add nothing of their own to what targets see, so there are no target-side rules.
# The model-request rules need TLS inspection of the MCP host's traffic to its model provider: the host sends each
# loaded tool's name and description with every request. Some descriptions carry typos or copy-paste errors that only
# this code has. Forks and the Bolt rewrite may keep them.

# --- Tool descriptions in model requests (TLS inspection needed) ---
alert http $HOME_NET any -> any any (msg:"TD MCP for Security nmap wrapper description in a model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"Run nmap with specified taget"; fast_pattern; content:"do-nmap"; classtype:policy-violation; sid:3813261; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family MCP-for-Security, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> any any (msg:"TD MCP for Security masscan wrapper description in a model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"Run masscan with specified target MASSCAN is a fast port scanner."; fast_pattern; content:"do-masscan"; classtype:policy-violation; sid:3813262; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family MCP-for-Security, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> any any (msg:"TD MCP for Security commix wrapper with the copied smuggler description in a model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"Run Smuggler to detect HTTP Request Smuggling vulnerabilities"; fast_pattern; content:"do-commix"; classtype:policy-violation; sid:3813263; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family MCP-for-Security, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> any any (msg:"TD MCP for Security HTTP header check description in a model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"Perform security analysis of HTTP response headers for a web application. This tool examines HTTP headers against OWASP"; fast_pattern; content:"analyze-http-header"; classtype:policy-violation; sid:3813264; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family MCP-for-Security, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> any any (msg:"TD MCP for Security nuclei wrapper description in a model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"Execute Nuclei, an advanced vulnerability scanner that uses YAML-based templates"; fast_pattern; content:"get-nuclei-tags"; classtype:policy-violation; sid:3813265; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family MCP-for-Security, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> any any (msg:"TD MCP for Security gowitness wrapper description in a model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"Capture screenshot of the given URL using gowitness scan single."; fast_pattern; content:"gowitness-batch-screenshot"; classtype:policy-violation; sid:3813266; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family MCP-for-Security, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> any any (msg:"TD MCP for Security ScoutSuite wrapper description in a model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"Performs an AWS cloud security audit using Scout Suite"; fast_pattern; content:"do-scoutsuite-aws"; classtype:policy-violation; sid:3813267; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family MCP-for-Security, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- The MobSF wrapper's requests to the operator's MobSF (plain HTTP by default, http://localhost:8000 in its README) ---
alert http $HOME_NET any -> any any (msg:"TD MCP for Security MobSF client request with both API key headers"; flow:established,to_server; http.uri; content:"/api/v1/"; startswith; http.user_agent; content:"axios/"; startswith; http.header; content:"X-Mobsf-Api-Key|3a 20|"; nocase; fast_pattern; content:"Authorization|3a 20|"; nocase; classtype:policy-violation; sid:3813268; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family MCP-for-Security, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)
