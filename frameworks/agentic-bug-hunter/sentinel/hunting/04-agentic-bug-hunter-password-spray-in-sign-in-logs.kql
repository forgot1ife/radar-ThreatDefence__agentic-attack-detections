// Agentic Bug Hunter password spray in Entra ID sign-in logs
// Agentic attack detections by ThreatDefence (Agentic Bug Hunter). Source: https://github.com/ThreatDefence/agentic-attack-detections
// ATT&CK: T1110.003 (Brute Force: Password Spraying)
// Example hunt for Microsoft Sentinel. Test and baseline before alerting.
// Agentic Bug Hunter's OAuth spray worker (bughunter/tools/_spray_oauth.py at 82f4512e) posts grant_type=password with
// one password for every user per round, with the fixed user agent
// "Mozilla/5.0 (Macintosh; Intel Mac OS X 10_15_7) Bug-Bounty-Research". The default pause between rounds is 1800 s
// plus or minus 60 s (--aggressive: 60 s plus or minus 10 s), so expect bursts of one attempt per user every 30 minutes.
// Its o365 and okta modes hand over to TREVORspray, which sends its own user agents: use the behavior hunts for those.

let Window = 30d;
union isfuzzy=true SigninLogs, AADNonInteractiveUserSignInLogs
| where TimeGenerated > ago(Window)
| where UserAgent endswith "Bug-Bounty-Research"
| summarize Attempts=count(), Users=dcount(UserPrincipalName), Successes=countif(ResultType == "0"),
    Lockouts=countif(ResultType == "50053"), Apps=make_set(AppDisplayName, 5), Results=make_set(ResultType, 10),
    FirstSeen=min(TimeGenerated), LastSeen=max(TimeGenerated) by IPAddress, UserAgent
| extend Rounds=Attempts / iff(Users == 0, 1, Users)
| order by Users desc
