# Agentic attack detections by ThreatDefence: Pensar Apex
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3813241-3813255. HTTP rules need cleartext HTTP or decrypted traffic.
# Apex is a terminal agent with no web console, so every rule here is for traffic it sends to a target or for its
# out-of-band callback listener (pensarai/apex at 6e3c5488).

# --- Requests that reach your targets ---
alert http any any -> any any (msg:"TD Pensar Apex default user agent pensar-apex"; flow:established,to_server; http.user_agent; content:"pensar-apex"; startswith; fast_pattern; classtype:web-application-attack; sid:3813241; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Pensar_Apex, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD Pensar Apex get_page user agent PensarBot"; flow:established,to_server; http.user_agent; content:"(compatible|3b| PensarBot/"; fast_pattern; classtype:web-application-attack; sid:3813242; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Pensar_Apex, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD Pensar Apex sign-up test account from the registration prompt"; flow:established,to_server; http.request_body; content:"TestPassword123"; fast_pattern; pcre:"/(?:testuser-\d{13}|test-\d{13}(?:@|%40)example\.com)/"; classtype:web-application-attack; sid:3813243; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Pensar_Apex, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1190, mitre_technique_name Exploit_Public-Facing_Application;)
alert http any any -> any any (msg:"TD Pensar Apex example prompt injection marker"; flow:established,to_server; http.request_body; content:"PROMPT_INJECTION_TEST_DIRECT_OVERRIDE"; fast_pattern; classtype:web-application-attack; sid:3813244; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Pensar_Apex, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1699, mitre_technique_name Direct_Prompt_Injection;)

# --- Out-of-band callback listener (start_callback_listener): answers only /<32 hex nonce>[/...] with this body ---
alert http any any -> any any (msg:"TD Pensar Apex callback listener answer"; flow:established,to_client; http.response_body; content:"apex-callback "; startswith; fast_pattern; pcre:"/^apex-callback [a-f0-9]{32}$/"; classtype:policy-violation; sid:3813245; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Pensar_Apex, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
