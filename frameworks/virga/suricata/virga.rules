# Agentic attack detections by ThreatDefence: Virga
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3818401-3818449. Strings from r74tech/virga at 43773ffe (server, listener and MCP code).
# The listener, admin API (8443), MCP servers (8444, 50012) and web UI (5173) are plain HTTP unless the operator adds TLS.

# --- Beacon traffic to a Virga listener (default uri_path api/updates) ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD Virga beacon check-in (Base64 body to /api/updates)"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/updates"; endswith; fast_pattern; http.request_body; pcre:"/^[A-Za-z0-9+\/]{100,}={0,2}$/"; classtype:trojan-activity; sid:3818401; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1573.001, mitre_technique_name Symmetric_Cryptography;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD Virga beacon stage 2 request"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/api/updates/stage2"; endswith; fast_pattern; classtype:trojan-activity; sid:3818402; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1105, mitre_technique_name Ingress_Tool_Transfer;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD Virga beacon generator default user agent (Chrome 96) in a POST"; flow:established,to_server; http.method; content:"POST"; http.user_agent; content:"Mozilla/5.0 (Windows NT 10.0|3b| Win64|3b| x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/96.0.4664.110 Safari/537.36"; startswith; endswith; fast_pattern; classtype:trojan-activity; sid:3818403; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- A Virga listener answering (decoy page and error strings) ---
alert http any any -> any any (msg:"TD Virga listener decoy 404 page"; flow:established,to_client; http.stat_code; content:"404"; http.response_body; content:"<html><body><h1>404 - Page Not Found</h1></body></html>"; startswith; endswith; fast_pattern; classtype:trojan-activity; sid:3818404; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Virga listener rejected a check-in (Invalid base64 data)"; flow:established,to_client; http.stat_code; content:"400"; http.response_body; content:"Invalid base64 data"; startswith; fast_pattern; classtype:trojan-activity; sid:3818405; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Virga MCP servers (SSE on 8444, Streamable HTTP on 50012; every interface in the shipped config; no auth) ---
alert http any any -> any any (msg:"TD Virga MCP server initialize answer (Virga MCP Server)"; flow:established,to_client; http.response_body; content:"serverInfo"; content:"Virga MCP Server"; fast_pattern; classtype:policy-violation; sid:3818406; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Virga MCP tool list (Virga C2 framework session tools)"; flow:established,to_client; http.response_body; content:"session_list"; content:"Virga C2 framework"; fast_pattern; classtype:policy-violation; sid:3818407; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Virga MCP tool call that drives a beacon"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"tools/call"; fast_pattern; pcre:"/\x22name\x22\s*:\s*\x22(?:session_command|interact_beacon|stop_interact)\x22/"; classtype:policy-violation; sid:3818408; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059, mitre_technique_name Command_and_Scripting_Interpreter;)
alert http any any -> any any (msg:"TD Virga MCP SSE stream request /mcp/events"; flow:established,to_server; http.method; content:"GET"; http.uri; content:"/mcp/events"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3818409; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- An exposed Virga console: web UI (5173) and admin API (8443, no auth) ---
alert http any any -> any any (msg:"TD Virga web UI page"; flow:established,to_client; http.response_body; content:"<title>Virga C2 - Web UI</title>"; fast_pattern; classtype:policy-violation; sid:3818410; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Virga admin API forest answer (c2-server node)"; flow:established,to_client; http.response_body; content:"|22|id|22 3a 22|c2-server|22|"; content:"|22|label|22 3a 22|Virga C2|22|"; fast_pattern; classtype:policy-violation; sid:3818411; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Virga admin API listener list"; flow:established,to_client; http.response_body; content:"{|22|listeners|22 3a|["; startswith; content:"|22|bind_address|22 3a|"; fast_pattern; content:"|22|success|22 3a|true}"; classtype:policy-violation; sid:3818412; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Virga admin API session list"; flow:established,to_client; http.response_body; content:"{|22|sessions|22 3a|["; startswith; fast_pattern; content:"],|22|success|22 3a|true}"; classtype:policy-violation; sid:3818413; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Virga admin API killswitch or beacon-config call"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/sessions/"; startswith; fast_pattern; pcre:"/^\/api\/sessions\/[^\/]+\/(?:killswitch|beacon-config)$/"; classtype:policy-violation; sid:3818414; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Virga, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
