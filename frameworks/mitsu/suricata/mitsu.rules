# Agentic attack detections by ThreatDefence: Mitsu
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3818901-3818949. Strings from ARCANGEL0/Mitsu at a4844932 (v1.5.2 plus one commit).
# Mitsu has no web console and its only listeners are bound to 127.0.0.1, so there are no console rules.
# 3818901 sees a target's plain-HTTP pages; HTTPS targets, search engines and pypi.org need TLS inspection.
# 3818903-3818905 need model traffic in clear text: a TLS-inspecting proxy, an AI gateway or a local model server.

# --- Mitsu's own HTTP client (search/engines.py:77, tui/updates.py:186) ---
alert http any any -> any any (msg:"TD Mitsu web_search user agent (page fetch or search scrape)"; flow:established,to_server; http.user_agent; content:"Mitsu/0.1 (terminal assistant|3b| public search)"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3818901; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Mitsu, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1594, mitre_technique_name Search_Victim-Owned_Websites, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1593.002, mitre_technique_name Search_Engines;)
alert http $HOME_NET any -> any any (msg:"TD Mitsu update check (decrypted)"; flow:established,to_server; http.user_agent; content:"Mitsu updater"; startswith; endswith; fast_pattern; http.uri; content:"/pypi/mitsu/json"; classtype:policy-violation; sid:3818902; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Mitsu, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.002, mitre_technique_name Tool;)

# --- Mitsu prompts and tool names inside cleartext or decrypted model requests ---
alert http $HOME_NET any -> any any (msg:"TD Mitsu system prompt in model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"You are Mitsu: the operator"; fast_pattern; classtype:policy-violation; sid:3818903; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Mitsu, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.007, mitre_technique_name Artificial_Intelligence;)
alert http $HOME_NET any -> any any (msg:"TD Mitsu fallback system prompt in model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"You are Mitsu, a security assessment assistant."; fast_pattern; classtype:policy-violation; sid:3818904; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Mitsu, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.007, mitre_technique_name Artificial_Intelligence;)
alert http $HOME_NET any -> any any (msg:"TD Mitsu MCP tool definitions in model request"; flow:established,to_server; http.method; content:"POST"; http.request_body; content:"mitsu__intel_upsert_asset"; fast_pattern; content:"mitsu__session_upsert"; classtype:policy-violation; sid:3818905; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Mitsu, mitre_tactic_id TA0042, mitre_tactic_name Resource_Development, mitre_technique_id T1588.007, mitre_technique_name Artificial_Intelligence;)
