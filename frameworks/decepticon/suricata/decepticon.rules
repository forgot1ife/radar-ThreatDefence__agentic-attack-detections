# Agentic attack detections by ThreatDefence: Decepticon
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3811301-3811349. DNS and TLS SNI rules work on encrypted traffic.
# HTTP rules on the telemetry, crt.sh and model gateway requests need TLS decryption; the others match cleartext HTTP.
# Built from BitterSecurity/Decepticon at 6b15092d (November 20, 2026); the web console rules from d26ddaa1, the last
# commit before the console was removed.

# --- Decepticon usage telemetry. The installer's setup wizard turns it on unless the operator says no ---
alert dns $HOME_NET any -> any any (msg:"TD Decepticon telemetry DNS query (decepticon-telemetry-gateway.purpleailab.workers.dev)"; dns.query; dotprefix; content:".decepticon-telemetry-gateway.purpleailab.workers.dev"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3811301; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Decepticon, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.004, mitre_technique_name DNS;)
alert tls $HOME_NET any -> $EXTERNAL_NET any (msg:"TD Decepticon telemetry TLS (decepticon-telemetry-gateway.purpleailab.workers.dev)"; flow:established,to_server; tls.sni; dotprefix; content:".decepticon-telemetry-gateway.purpleailab.workers.dev"; nocase; endswith; fast_pattern; classtype:policy-violation; sid:3811302; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Decepticon, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD Decepticon telemetry client user agent"; flow:established,to_server; http.user_agent; content:"decepticon-telemetry/1.0"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3811303; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Decepticon, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Requests from the host that runs Decepticon ---
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD Decepticon passive subdomain discovery on crt.sh"; flow:established,to_server; http.user_agent; content:"decepticon-roe/1"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3811304; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Decepticon, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1596.003, mitre_technique_name Digital_Certificates;)
alert http any any -> any any (msg:"TD Decepticon sandbox command transport"; flow:established,to_server; http.user_agent; content:"decepticon-http-sandbox/1"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3811305; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Decepticon, mitre_tactic_id TA0002, mitre_tactic_name Execution, mitre_technique_id T1059.004, mitre_technique_name Unix_Shell;)
alert http $HOME_NET any -> $EXTERNAL_NET any (msg:"TD Decepticon ChatGPT subscription gateway default user agent"; flow:established,to_server; http.user_agent; content:"codex_cli_rs/0.0.0 (Unknown 0|3b| unknown) unknown"; startswith; endswith; fast_pattern; classtype:policy-violation; sid:3811306; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Decepticon, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Exposed services: sandbox daemon, LangGraph API, the removed web console ---
alert http any any -> any any (msg:"TD Decepticon sandbox daemon API page"; flow:established,to_client; http.response_body; content:"Decepticon sandbox daemon"; fast_pattern; classtype:policy-violation; sid:3811310; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Decepticon, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Decepticon LangGraph server plugin or RoE API request"; flow:established,to_server; http.uri; content:"/_decepticon/"; startswith; fast_pattern; classtype:policy-violation; sid:3811311; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Decepticon, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Decepticon web console page (removed November 11, 2026)"; flow:established,to_client; http.response_body; content:"<title>Decepticon |e2 80 94| Autonomous Red Team Platform</title>"; fast_pattern; classtype:policy-violation; sid:3811312; rev:1; metadata:created_at 2026_11_26, confidence High, malware_family Decepticon, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
alert http any any -> any any (msg:"TD Decepticon web console health answer"; flow:established,to_client; http.response_body; content:"|22|services|22 3a 5b 7b 22|name|22 3a 22|langgraph|22|"; fast_pattern; content:"|22|modelCount|22 3a|"; classtype:policy-violation; sid:3811313; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Decepticon, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)

# --- Requests that reach your targets. Most target traffic comes from ordinary tools and impersonated browsers ---
# Decepticon/1.0 is in the http_recon helper and on one model gateway entry; neither is bound to an agent at 6b15092d.
alert http any any -> any any (msg:"TD Decepticon user agent token"; flow:established,to_server; http.user_agent; content:"Decepticon/"; fast_pattern; classtype:attempted-recon; sid:3811320; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Decepticon, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
# The opsec skill gives user agent templates with <CHROME_VER>, <FIREFOX_VER> and <CURRENT_VER> for the model to fill in.
alert http any any -> any any (msg:"TD Decepticon opsec skill user agent template sent unfilled"; flow:established,to_server; http.user_agent; content:"_VER>"; fast_pattern; pcre:"/(?:Chrome\/|Firefox\/|rv:)<(?:CHROME|FIREFOX|CURRENT)_VER>/"; classtype:attempted-recon; sid:3811321; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Decepticon, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
# web_fetch: curl_cffi browser impersonation with fixed Accept and Korean-first Accept-Language. Real Korean Safari
# sends the same pair, so this rule needs a Chrome user agent, which real Chrome never sends with this Accept.
alert http any any -> any any (msg:"TD Decepticon web fetch engine headers with a Chrome user agent"; flow:established,to_server; http.accept_lang; content:"ko-KR,ko|3b|q=0.9,en-US|3b|q=0.8,en|3b|q=0.7"; startswith; endswith; fast_pattern; http.accept; content:"text/html,application/xhtml+xml,application/xml|3b|q=0.9,*/*|3b|q=0.8"; startswith; endswith; http.user_agent; content:"Chrome/"; classtype:attempted-recon; sid:3811322; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Decepticon, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
alert http any any -> any any (msg:"TD Decepticon web fetch platform probe headers"; flow:established,to_server; http.accept_lang; content:"en-US,en|3b|q=0.9,ko|3b|q=0.8"; startswith; endswith; fast_pattern; http.accept; content:"text/html,application/xhtml+xml,application/xml|3b|q=0.9,*/*|3b|q=0.8"; startswith; endswith; classtype:attempted-recon; sid:3811323; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family Decepticon, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
# The phisher skill tells the agent to put X-Decepticon-Eng: <slug> on every lure, so a SOC can tell an agreed test apart.
alert tcp any any -> any [25,587,2525] (msg:"TD Decepticon phishing lure engagement header in SMTP"; flow:established,to_server; content:"X-Decepticon-Eng|3a|"; nocase; fast_pattern; classtype:policy-violation; sid:3811324; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family Decepticon, mitre_tactic_id TA0001, mitre_tactic_name Initial_Access, mitre_technique_id T1566.002, mitre_technique_name Spearphishing_Link;)
