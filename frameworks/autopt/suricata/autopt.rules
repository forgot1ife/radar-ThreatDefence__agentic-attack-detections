# Agentic attack detections by ThreatDefence: AutoPT
# https://github.com/ThreatDefence/agentic-attack-detections
# Suricata 7 and 8. SID range 3812601-3812649. HTTP rules need cleartext HTTP or decrypted traffic.
# The console (Flask development server, port 5000) is plain HTTP, so its rules work without decryption.

# --- Requests that reach your targets ---
# ReadHTML and the vulhub fetch send a Chrome string cut off before "(KHTML, like Gecko)" (src/utils.py:87-90, src/psm/state.py:316-318).
# CyberStrikeAI's implant and a Xalgorix prompt example use the same string, so this names a family of tools, not AutoPT alone.
alert http any any -> $HTTP_SERVERS any (msg:"TD Truncated Chrome user agent of AI pentest agents (AutoPT page reader, PentestAgent GH05TCREW browser, CyberStrikeAI implant)"; flow:established,to_server; http.user_agent; content:"Mozilla/5.0 (Windows NT 10.0|3b| Win64|3b| x64) AppleWebKit/537.36"; startswith; endswith; fast_pattern; classtype:web-application-attack; sid:3812601; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family AutoPT, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning, mitre_tactic_id TA0005, mitre_tactic_name Stealth, mitre_technique_id T1036.012, mitre_technique_name Browser_Fingerprint;)
# The upstream engine (Dizzy-K/AutoPT tools/web.py:38 at fb26e0c4) names itself on every ReadHTML request.
alert http any any -> any any (msg:"TD AutoPT upstream page reader user agent"; flow:established,to_server; http.user_agent; content:"AutoPT/"; startswith; fast_pattern; classtype:web-application-attack; sid:3812602; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family AutoPT, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)

# --- An exposed AutoPT console (5000) ---
# The page title and sidebar text (frontend/index.html:6,17).
alert http any any -> any any (msg:"TD AutoPT console page"; flow:established,to_client; http.response_body; content:"<title>AutoPT - "; fast_pattern; content:"AI Penetration Testing"; distance:0; classtype:policy-violation; sid:3812603; rev:1; metadata:created_at 2026_11_26, confidence Low, malware_family AutoPT, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
# GET /api/config answers without a login with the whole config.yml, model keys included (app.py:80-83).
alert http any any -> any any (msg:"TD AutoPT console configuration with model keys served"; flow:established,to_client; http.response_body; content:"|22|openai_key|22|"; fast_pattern; content:"|22|xray_path|22|"; content:"|22|exp_iterations|22|"; classtype:policy-violation; sid:3812604; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family AutoPT, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0006, mitre_tactic_name Credential_Access, mitre_technique_id T1552.001, mitre_technique_name Credentials_In_Files;)
# GET /api/system/info answers without a login (app.py:598-617).
alert http any any -> any any (msg:"TD AutoPT console system info"; flow:established,to_client; http.response_body; content:"|22|xray_info|22|"; fast_pattern; content:"|22|docker_available|22|"; classtype:policy-violation; sid:3812605; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family AutoPT, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols;)
# POST /api/task/start with {"name","ip_addr","model"} starts an agent run; no login (app.py:490-512).
alert http any any -> any any (msg:"TD AutoPT console agent run started"; flow:established,to_server; http.method; content:"POST"; http.uri; content:"/api/task/start"; endswith; fast_pattern; http.request_body; content:"|22|ip_addr|22|"; classtype:policy-violation; sid:3812606; rev:1; metadata:created_at 2026_11_26, confidence Medium, malware_family AutoPT, mitre_tactic_id TA0011, mitre_tactic_name Command_and_Control, mitre_technique_id T1071.001, mitre_technique_name Web_Protocols, mitre_tactic_id TA0043, mitre_tactic_name Reconnaissance, mitre_technique_id T1595.002, mitre_technique_name Vulnerability_Scanning;)
