// Web and database services starting shells and download tools
// Agentic attack detections by ThreatDefence (general intrusion behavior, first written for ARTEX). Source: https://threatdefence.com/article/artex-agentic-attack-framework-detection-hunting
// ATT&CK: T1505.003 (Server Software Component: Web Shell), T1190 (Exploit Public-Facing Application), T1059 (Command and Scripting Interpreter)
// Example hunt for Microsoft Sentinel and Defender XDR advanced hunting. Test and baseline before alerting.
// A web shell, a command injection flaw and a database that can run operating system commands all look the same in process data: the service starts a shell.
// The threshold of five different commands in ten minutes picks out the agent's trial and error. Lower it to find a single careful command.

// Example: Defender for Endpoint, shells, discovery commands and download tools started by web or database services
let ServiceProcesses = dynamic(["w3wp.exe", "httpd.exe", "httpd", "nginx.exe", "nginx", "php-cgi.exe", "php-fpm",
    "php", "tomcat.exe", "tomcat9.exe", "java.exe", "java", "node.exe", "node", "sqlservr.exe", "mysqld.exe", "mysqld"]);
let Tools = dynamic(["cmd.exe", "powershell.exe", "pwsh.exe", "sh", "bash", "dash", "curl.exe", "curl", "wget",
    "nc", "ncat", "nc.exe", "whoami.exe", "whoami", "tasklist.exe", "net.exe", "nltest.exe", "certutil.exe", "python3"]);
DeviceProcessEvents
| where Timestamp > ago(30d)
| where InitiatingProcessFileName in~ (ServiceProcesses) and FileName in~ (Tools)
// java and node also run Jenkins, npm and AI agent CLIs: count them only under a service account
| where InitiatingProcessFileName !in~ ("java", "java.exe", "node", "node.exe")
    or AccountName in~ ("www-data", "apache", "nginx", "http", "tomcat", "tomcat9", "jetty", "jboss", "wildfly", "node", "nodejs", "nobody", "daemon",
        "network service", "local service", "iusr")
    or AccountDomain =~ "iis apppool"
| summarize Commands=count(), Distinct=dcount(ProcessCommandLine), Sample=make_set(ProcessCommandLine, 15),
            FirstSeen=min(Timestamp), LastSeen=max(Timestamp)
    by DeviceName, InitiatingProcessFileName, AccountName, bin(Timestamp, 10m)
| where Distinct >= 5
| order by Distinct desc
