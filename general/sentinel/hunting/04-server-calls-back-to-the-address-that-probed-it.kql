// A server calls back to the address that was probing it
// Agentic attack detections by ThreatDefence (general intrusion behavior). Source: https://github.com/ThreatDefence/agentic-attack-detections
// ATT&CK: T1190 (Exploit Public-Facing Application), T1071 (Application Layer Protocol)
// Example hunt for Defender XDR advanced hunting with web logs in Microsoft Sentinel. Test and baseline before alerting.
// Agentic frameworks catch reverse shells and out-of-band callbacks on the same machine that runs the attack. PentAGI
// publishes two listener ports per engagement from 28000 on every interface of its host (backend/pkg/docker/client.go),
// and Elastic lists connections from compromised hosts to TCP 28000 to 29999 on the PentAGI host as the thing to watch.
// Cairn's workers share the host network, and its workspace guide tells the agent that reverse shells and out-of-band
// callbacks should use the host's own external address. In both cases, a server you own opens an outbound connection to
// an address that was sending it requests shortly before. Ordinary servers rarely connect out to the addresses that
// browse them.

let Window = 7d;
let Lookback = 1d;
let Probers = union isfuzzy=true
    (CommonSecurityLog | where TimeGenerated > ago(Window) | project TimeGenerated, Prober=SourceIP, Target=DestinationIP),
    (W3CIISLog | where TimeGenerated > ago(Window) | project TimeGenerated, Prober=cIP, Target=sIP)
    | where not(ipv4_is_private(Prober))
    | summarize ProbeRequests=count(), FirstProbe=min(TimeGenerated), LastProbe=max(TimeGenerated) by Prober;
DeviceNetworkEvents
| where Timestamp > ago(Window)
| where ActionType in ("ConnectionSuccess", "ConnectionAttempt") and RemoteIPType == "Public"
| join kind=inner Probers on $left.RemoteIP == $right.Prober
// Outbound to the prober during or within a day after its requests
| where Timestamp between (FirstProbe .. (LastProbe + Lookback))
| extend PentagiPorts = RemotePort between (28000 .. 29999)
| summarize Connections=count(), Ports=make_set(RemotePort, 10), Processes=make_set(InitiatingProcessFileName, 10),
    Commands=make_set(substring(InitiatingProcessCommandLine, 0, 200), 5), FirstCallback=min(Timestamp),
    PentagiPortHit=max(toint(PentagiPorts)) by DeviceName, RemoteIP, ProbeRequests
| extend Note = iff(PentagiPortHit == 1, "callback to a PentAGI worker port range", "callback to the probing address")
| order by PentagiPortHit desc, Connections desc
